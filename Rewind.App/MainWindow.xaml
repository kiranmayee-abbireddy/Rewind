<Window x:Class="Rewind.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="REWIND — Bug Evidence Recorder for QA" Height="720" Width="1080"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen" Background="#0D1117" Foreground="#F0F6FC">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar: Sessions List & Controls -->
        <Border Grid.Column="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,1,0" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⏪" FontSize="20" Margin="0,0,8,0"/>
                        <TextBlock Text="REWIND" FontSize="20" FontWeight="Bold" Foreground="#F0F6FC"/>
                    </StackPanel>
                    <TextBlock Text="Never lose a bug because you forgot to record." FontSize="11" Foreground="#8B949E" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- New Session Button -->
                <Button Grid.Row="1" Content="+ New Testing Session" Click="NewSession_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,0,16"/>

                <!-- Session History -->
                <DockPanel Grid.Row="2">
                    <TextBlock DockPanel.Dock="Top" Text="PAST SESSIONS" FontSize="11" FontWeight="Bold" Foreground="#8B949E" Margin="0,0,0,8"/>
                    <ListBox x:Name="SessionsList" SelectionChanged="SessionsList_SelectionChanged" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#21262D" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#F0F6FC" FontSize="13"/>
                                        <Grid Margin="0,4,0,0">
                                            <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#58A6FF"/>
                                            <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:MM/dd HH:mm}'}" HorizontalAlignment="Right" FontSize="10" Foreground="#8B949E"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- Footer Settings Status -->
                <Border Grid.Row="3" Background="#21262D" CornerRadius="6" Padding="8" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="⚙ Settings" FontWeight="SemiBold" FontSize="11" Foreground="#8B949E"/>
                        <TextBlock Text="Buffer: 60s @ 15fps (H.264)" FontSize="10" Foreground="#C9D1D9" Margin="0,2,0,0"/>
                        <TextBlock Text="Storage: Local SQLite / MP4" FontSize="10" Foreground="#C9D1D9"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Workspace Area -->
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header & Active Session Status -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel>
                    <TextBox x:Name="ActiveSessionTitleBox" Text="Active Session" FontSize="22" FontWeight="Bold" Background="Transparent" Foreground="#F0F6FC" BorderThickness="0" Margin="0,0,0,4"/>
                    <TextBlock x:Name="ActiveSessionSubtext" Text="Capture: Idle • No active recording" FontSize="13" Foreground="#8B949E"/>
                </StackPanel>

                <!-- Recording Controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="StartStopCaptureBtn" Content="▶ Start Capture" Click="StartStopCapture_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                    <Button x:Name="PauseResumeBtn" Content="⏸ Pause" Click="PauseResume_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" IsEnabled="False"/>
                    <Button x:Name="PreserveBugBtn" Content="⚡ Preserve Bug" Click="PreserveBug_Click" Style="{StaticResource PrimaryButton}" Background="#D29922" Margin="0,0,8,0" IsEnabled="False"/>
                    <Button x:Name="GenerateReportBtn" Content="📑 Generate Report" Click="GenerateReport_Click" Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </Grid>

            <!-- Buffer Status Banner -->
            <Border Grid.Row="1" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Ellipse x:Name="MainStatusDot" Width="12" Height="12" Fill="#8B949E" Margin="0,0,8,0"/>
                        <TextBlock x:Name="MainStatusLabel" Text="IDLE" FontWeight="Bold" FontSize="13" Foreground="#8B949E" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="BufferStatsText" Text="Continuous rolling buffer is stopped. Click 'Start Capture' to begin." FontSize="12" Foreground="#C9D1D9"/>
                        <TextBlock Text="When you discover a bug, click 'Preserve Bug' or use the Floating HUD to save the past 30-60s of footage." FontSize="11" Foreground="#8B949E" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="2" Content="Show Floating HUD" Click="ShowHud_Click" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Bugs List Section -->
            <DockPanel Grid.Row="2">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="CAPTURED BUGS &amp; EVIDENCE" FontSize="13" FontWeight="Bold" Foreground="#8B949E"/>
                    <TextBlock x:Name="BugCountLabel" Text="0 bugs saved" HorizontalAlignment="Right" FontSize="12" Foreground="#8B949E"/>
                </Grid>

                <!-- Bugs Items Control / List -->
                <ListBox x:Name="BugsList" Background="Transparent" BorderThickness="0" MouseDoubleClick="BugsList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Thumbnail or Icon -->
                                    <Border Grid.Column="0" Background="#090D13" CornerRadius="6" Height="80" Margin="0,0,16,0">
                                        <Grid>
                                            <TextBlock Text="🎬 Clip" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8B949E" FontSize="12"/>
                                            <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill"/>
                                        </Grid>
                                    </Border>

                                    <!-- Details -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15" Foreground="#F0F6FC"/>
                                        <TextBlock Text="{Binding ObservedBehavior}" FontSize="12" Foreground="#8B949E" Margin="0,4,0,4" MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#21262D" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Status}" FontSize="10" Foreground="#58A6FF" FontWeight="SemiBold"/>
                                            </Border>
                                            <TextBlock Text="{Binding DurationSeconds, StringFormat='Duration: {0:0.0}s'}" FontSize="11" Foreground="#8B949E" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding CreatedAt, StringFormat='Captured: {0:HH:mm:ss}'}" FontSize="11" Foreground="#8B949E" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Action -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Button Content="Edit &amp; Review" Tag="{Binding}" Click="EditBug_Click" Style="{StaticResource SecondaryButton}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
