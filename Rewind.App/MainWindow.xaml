<Window x:Class="Rewind.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="REWIND — Bug Evidence Recorder" Height="730" Width="1090"
        MinHeight="600" MinWidth="850" Icon="app.ico"
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None" AllowsTransparency="False"
        Background="{DynamicResource BgPrimaryBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootWindowGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Luxury Title Bar -->
        <Border Grid.Row="0" Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: App Identity (Consistent Avocado Mascot + REWIND Branding) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl Template="{StaticResource AvocadoMascotCompact}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="REWIND" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center: Drag Area (Clean Minimalist Title Bar) -->
                <Grid Grid.Column="1" Background="Transparent"/>

                <!-- Right Controls: Quick Floating HUD, Theme Toggle + Window Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch" WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Quick Toggle Companion HUD -->
                    <Button x:Name="HudToggleHeaderBtn" Click="ShowHud_Click" ToolTip="Toggle Desktop Companion HUD (Show/Hide)"
                            Style="{StaticResource SecondaryButton}" Height="28" Padding="10,0" Margin="0,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource WinHudPipetteGeometry}" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="HudToggleHeaderLabel" Text="HUD" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Quick Open Settings Preferences Button -->
                    <Button x:Name="HeaderSettingsBtn" Click="OpenSettings_Click" ToolTip="Settings &amp; Capture Profiles"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource SecondaryButton}" Height="28" Padding="10,0" Margin="0,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource GearGeometry}" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Settings" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Light / Dark Mode Toggle Button -->
                    <Button x:Name="ThemeToggleBtn" Click="ThemeToggle_Click" ToolTip="Toggle Light / Dark Mode"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Width="32" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Path x:Name="ThemeIconPath" Data="{StaticResource SunGeometry}" Fill="{DynamicResource GoldBrush}" Stretch="Uniform" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Precise Vector Window Management Buttons (Stretch 42px) -->
                    <Button Click="MinimizeWindow_Click" Style="{StaticResource WindowControlButton}" ToolTip="Minimize" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="{StaticResource WinMinimizeGeometry}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Stretch="Uniform" Width="10" Height="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="MaximizeBtn" Click="MaximizeWindow_Click" Style="{StaticResource WindowControlButton}" ToolTip="Maximize / Restore" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path x:Name="MaximizeIconPath" Data="{StaticResource WinMaximizeGeometry}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Stretch="Uniform" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Click="CloseWindow_Click" Style="{StaticResource WindowCloseButton}" ToolTip="Close" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="{StaticResource WinCloseGeometry}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Stretch="Uniform" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar: Sessions List & Controls (Structured 3-Row Grid: Settings Card Guaranteed Visible in Any Resolution & Fullscreen) -->
            <Border Grid.Column="0" Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="14,14,14,14" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Row 0: Mascot Header, New Session & Past Sessions Title -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 1: Past Sessions List (Takes Remaining Vertical Space, Scrollable) -->
                        <RowDefinition Height="*"/>
                        <!-- Row 2: Settings & Profiles Card (Fixed Height at Bottom, NEVER Cut Off) -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Controls: Header Mascot & New Session Button -->
                    <StackPanel Grid.Row="0">
                        <!-- Clean Header Identity & Avocado Companion Showcase -->
                        <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Guac the Avocado QA Companion -->
                                <ContentControl Template="{StaticResource AvocadoMascot}" Margin="0,0,12,0" VerticalAlignment="Center" ToolTip="Guac — Your REWIND QA Companion"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="REWIND" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Evidence Recorder" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- New Session Action Button -->
                        <Button Click="NewSession_Click" Style="{StaticResource PrimaryButton}" Height="34" Margin="0,0,0,12" Padding="0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource PlusGeometry}" Fill="#FFFFFF" Stretch="Uniform" Width="11" Height="11" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="New Session" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Past Sessions Header Label -->
                        <Grid Margin="2,0,2,8">
                            <TextBlock Text="PAST SESSIONS" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Session History List (Fills Center, Scrolls Gracefully with No Visual Scrollbars) -->
                    <ListBox Grid.Row="1" x:Name="SessionsList" SelectionChanged="SessionsList_SelectionChanged" 
                             Background="Transparent" BorderThickness="0" 
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,5"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="11,9">
                                                <Grid>
                                                    <!-- Left subtle accent indicator line for selection -->
                                                    <Border x:Name="ActiveIndicator" Width="3" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" CornerRadius="1.5" Margin="-11,-9,0,-9" Visibility="Collapsed"/>
                                                    <ContentPresenter/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                    
                                    <!-- Delete Session Icon Button (Hover / Click) -->
                                    <Button Grid.Row="0" Grid.Column="1" Click="DeleteSessionItem_Click" Tag="{Binding}"
                                            ToolTip="Delete Session &amp; Saved Evidence"
                                            Background="Transparent" BorderThickness="0" Padding="4,2" Margin="4,-2,0,0" Cursor="Hand" VerticalAlignment="Center">
                                        <Path Data="{StaticResource TrashGeometry}" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" Width="11" Height="11" Opacity="0.6"/>
                                    </Button>

                                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,5,0,0">
                                        <Border HorizontalAlignment="Left" CornerRadius="3" Padding="5,1" Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                        <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:MM/dd HH:mm}'}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Persistent Footer Settings Card (Guaranteed Row 2, Always Fully Visible in Fullscreen & Any Height) -->
                    <Border Grid.Row="2" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,10,0,0"
                            Cursor="Hand" PreviewMouseLeftButtonDown="OpenSettings_Click" MouseLeftButtonUp="OpenSettings_Click" ToolTip="Click to open Settings &amp; Capture Profiles">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Settings Icon -->
                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6" Background="{DynamicResource BgSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False">
                                <Path Data="{StaticResource GearGeometry}" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Settings Details -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock Text="Settings &amp; Profiles" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="SettingsSummaryText" Text="Buffer: 60s @ 15fps" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Open Dialog Button -->
                            <Button x:Name="SidebarSettingsEditBtn" Grid.Column="2" Click="OpenSettings_Click" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Padding="8,4" FontSize="11" Margin="6,0,0,0">
                                <TextBlock Text="Edit" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Main Workspace Area -->
            <Grid Grid.Column="1" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Cinematic Studio Header & Session Control Hub -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBox x:Name="ActiveSessionTitleBox" Text="Active Session" FontSize="20" FontWeight="Bold" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Margin="0,0,0,3"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource AccentBrush}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="ActiveSessionSubtext" Text="Capture: Idle • No active recording" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Studio Action Ribbon -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="StartStopCaptureBtn" Content="▶ Start Capture" Click="StartStopCapture_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0"/>
                        <Button x:Name="PauseResumeBtn" Content="⏸ Pause" Click="PauseResume_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" IsEnabled="False"/>
                        <Button x:Name="PreserveBugBtn" Content="⚡ Preserve Evidence" Click="PreserveBug_Click" Style="{StaticResource PrimaryButton}" Background="{DynamicResource GoldBrush}" BorderBrush="{DynamicResource GoldBrush}" Margin="0,0,6,0" IsEnabled="False"/>
                        <Button x:Name="GenerateReportBtn" Content="📑 Report" Click="GenerateReport_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
                        <Button x:Name="DeleteActiveSessionBtn" Click="DeleteActiveSession_Click" Style="{StaticResource SecondaryButton}" ToolTip="Delete Active Session &amp; Files" Padding="8,6">
                            <Path Data="{StaticResource TrashGeometry}" Fill="{DynamicResource DangerBrush}" Stretch="Uniform" Width="12" Height="12"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Cinematic Recording Monitor Card -->
                <Border Grid.Row="1" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Live Status Pill & Timecode Meter -->
                        <Border Grid.Column="0" Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,16,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="MainStatusDot" Width="8" Height="8" CornerRadius="4" Background="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="MainStatusLabel" Text="IDLE" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="MainTimecodeText" Text="00:00" FontFamily="Consolas, monospace" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="BufferStatsText" Text="Continuous rolling buffer is stopped. Click 'Start Capture' to begin monitoring." FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ProcessingStatusText" Text="Rolling buffer runs silently in memory. Press Hotkey or HUD button when an issue occurs." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            <ProgressBar x:Name="PreservationProgressBar" Height="3" Minimum="0" Maximum="100" IsIndeterminate="False" Visibility="Collapsed" Margin="0,6,0,0" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BgSecondaryBrush}" BorderThickness="0"/>
                        </StackPanel>

                        <Button Grid.Column="2" Content="Floating HUD" Click="ShowHud_Click" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Padding="10,5" FontSize="11"/>
                    </Grid>
                </Border>

                <!-- Bugs List Section -->
                <DockPanel Grid.Row="2">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="CAPTURED BUGS &amp; EVIDENCE" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="BugCountLabel" Text="0 bugs saved" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>

                    <!-- Bugs Items Control / List (Scrollable without visible scrollbar) -->
                    <ListBox x:Name="BugsList" Background="Transparent" BorderThickness="0" MouseDoubleClick="BugsList_MouseDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,10"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.25"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="144"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Video Preview Thumbnail Container -->
                                        <Border Grid.Column="0" Background="{DynamicResource BgPrimaryBrush}" CornerRadius="6" Height="82" Margin="0,0,16,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                                            <Grid>
                                                <TextBlock Text="🎬 MP4 Clip" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                                                <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill"/>
                                                <!-- Sub-badge showing duration on thumbnail -->
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#CC000000" CornerRadius="4" Padding="5,2" Margin="4">
                                                    <TextBlock Text="{Binding DurationSeconds, StringFormat={}{0:0.0}s}" FontSize="10" Foreground="#F3F6FC" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Defect Description & Title -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ObservedBehavior}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,7" LineHeight="17" MaxHeight="36" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="{DynamicResource BgSecondaryBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                    <TextBlock Text="{Binding DurationSeconds, StringFormat='Duration: {0:0.0}s'}" FontSize="10.5" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                                                </Border>
                                                <TextBlock Text="{Binding CreatedAt, StringFormat='Preserved at {0:HH:mm:ss}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Action Button -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0">
                                            <Button Content="Edit &amp; Review" Tag="{Binding}" Click="EditBug_Click" Style="{StaticResource SecondaryButton}" Padding="14,7"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
