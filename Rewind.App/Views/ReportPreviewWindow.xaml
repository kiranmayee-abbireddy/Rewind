<Window x:Class="Rewind.App.Views.ReportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Consolidated QA Bug Report" Height="600" Width="750"
        WindowStartupLocation="CenterScreen" Background="#0D1117" Foreground="#F0F6FC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Consolidated QA Bug Report" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Edit, review, or export report formatted for Jira, GitHub Issues, or CI/CD pipelines." FontSize="12" Foreground="#8B949E" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Format: " VerticalAlignment="Center" Foreground="#8B949E" Margin="0,0,6,0"/>
                <ComboBox x:Name="FormatCombo" SelectionChanged="FormatCombo_SelectionChanged" Background="#161B22" Foreground="#FFFFFF" BorderBrush="#30363D" Width="130">
                    <ComboBoxItem Content="Markdown (.md)" IsSelected="True"/>
                    <ComboBoxItem Content="Jira Markup"/>
                    <ComboBoxItem Content="JSON Data"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <TextBox Grid.Row="1" x:Name="ReportBox" Background="#161B22" Foreground="#F0F6FC" BorderBrush="#30363D" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="13" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="12" Margin="0,0,0,16"/>

        <Grid Grid.Row="2">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="CopyStatusText" Text="" Foreground="#3FB950" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="💾 Save as .md" Click="SaveFile_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                <Button Content="📋 Copy to Clipboard" Click="Copy_Click" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
