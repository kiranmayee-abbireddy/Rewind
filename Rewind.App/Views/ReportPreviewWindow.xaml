<Window x:Class="Rewind.App.Views.ReportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Consolidated QA Bug Report" Height="600" Width="750"
        WindowStartupLocation="CenterScreen" Background="#0D1117" Foreground="#F0F6FC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="QA Bug Report &amp; Evidence Log" FontSize="18" FontWeight="Bold" Foreground="#F3F6FC"/>
                <TextBlock Text="Clean list of defects with descriptions and associated video filenames." FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Format: " VerticalAlignment="Center" Foreground="#94A3B8" Margin="0,0,8,0" FontSize="12"/>
                <ComboBox x:Name="FormatCombo" SelectionChanged="FormatCombo_SelectionChanged" Background="#111620" Foreground="#F3F6FC" BorderBrush="#253043" Width="170">
                    <ComboBoxItem Content="Clean List &amp; Videos" IsSelected="True"/>
                    <ComboBoxItem Content="Markdown (.md)"/>
                    <ComboBoxItem Content="Jira Markup"/>
                    <ComboBoxItem Content="JSON Data"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <TextBox Grid.Row="1" x:Name="ReportBox" Background="#111620" Foreground="#F3F6FC" BorderBrush="#253043" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="13" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="14" Margin="0,0,0,16"/>

        <Grid Grid.Row="2">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="CopyStatusText" Text="" Foreground="#3FB950" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="💾 Save as .md" Click="SaveFile_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                <Button Content="📋 Copy to Clipboard" Click="Copy_Click" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
