<Window x:Class="Rewind.App.Views.ReportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Consolidated QA Bug Report" Height="600" Width="750" Icon="pack://application:,,,/app.ico"
        MinHeight="450" MinWidth="600"
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None" AllowsTransparency="False"
        Background="{DynamicResource BgPrimaryBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar with Avocado Mascot -->
        <Border Grid.Row="0" Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl Template="{StaticResource AvocadoMascotCompact}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="QA Bug Report &amp; Evidence Log" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Window Close Button -->
                <Button Grid.Column="2" Click="Close_Click" Style="{StaticResource WindowCloseButton}" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="{StaticResource WinCloseGeometry}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Stretch="Uniform" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </Border>

        <!-- Main Body -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Export Evidence Summary" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Clean list of defects with descriptions and associated video filenames." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Format: " VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" FontSize="12"/>
                    <ComboBox x:Name="FormatCombo" SelectionChanged="FormatCombo_SelectionChanged" Background="{DynamicResource BgCardBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" Width="170">
                        <ComboBoxItem Content="Clean List &amp; Videos" IsSelected="True"/>
                        <ComboBoxItem Content="Markdown (.md)"/>
                        <ComboBoxItem Content="Jira Markup"/>
                        <ComboBoxItem Content="JSON Data"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <TextBox Grid.Row="1" x:Name="ReportBox" Background="{DynamicResource BgCardBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="13" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="14" Margin="0,0,0,16"/>

            <Grid Grid.Row="2">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="CopyStatusText" Text="" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="💾 Save as .md" Click="SaveFile_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                    <Button Content="📋 Copy to Clipboard" Click="Copy_Click" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
