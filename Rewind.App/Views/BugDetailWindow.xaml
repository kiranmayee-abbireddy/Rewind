<Window x:Class="Rewind.App.Views.BugDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bug Detail &amp; Evidence Review" Height="650" Width="850" Icon="pack://application:,,,/app.ico"
        MinHeight="450" MinWidth="600"
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None" AllowsTransparency="False"
        Background="{DynamicResource BgPrimaryBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar with Avocado Mascot -->
        <Border Grid.Row="0" Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl Template="{StaticResource AvocadoMascotCompact}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Bug Detail &amp; Evidence Review" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Window Close Button -->
                <Button Grid.Column="2" Click="Save_Click" Style="{StaticResource WindowCloseButton}" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="{StaticResource WinCloseGeometry}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Stretch="Uniform" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </Border>

        <!-- Main Body -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBox x:Name="TitleBox" Text="Bug Title" FontSize="20" FontWeight="Bold" Background="Transparent" Foreground="#F0F6FC" BorderThickness="0" Margin="0,0,0,4"/>
                <TextBlock x:Name="MetaInfoText" Text="Captured at 12:00:00 • 30.0s clip" FontSize="12" Foreground="#8B949E"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Play Video in Player" Click="PlayVideo_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                <Button Content="Delete Bug" Click="Delete_Click" Style="{StaticResource DangerButton}"/>
            </StackPanel>
        </Grid>

        <!-- Body / Two Column Layout -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Video Player & Preview -->
            <Border Grid.Column="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Media Player with Image fallback -->
                    <Grid Grid.Row="0" Background="{DynamicResource BgPrimaryBrush}">
                        <MediaElement x:Name="ClipMediaPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" ScrubbingEnabled="True"/>
                        <Image x:Name="ThumbnailImage" Stretch="Uniform" Visibility="Visible"/>
                    </Grid>

                    <!-- Player Controls & Timeline -->
                    <Grid Grid.Row="1" Margin="0,10,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" x:Name="PlayPauseMediaBtn" Content="▶ Play" Click="TogglePlayMedia_Click" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,8,0"/>
                        <Slider Grid.Column="1" x:Name="MediaPositionSlider" Minimum="0" Value="0" VerticalAlignment="Center" ValueChanged="MediaPositionSlider_ValueChanged"/>
                        <TextBlock Grid.Column="2" x:Name="MediaTimeLabel" Text="00:00 / 00:00" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Grid.Row="2">
                        <TextBlock x:Name="ClipPathLabel" Text="Evidence: clip.mp4" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Metadata & QA Report Fields (Scrollable without scrollbar) -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Hidden">
                <StackPanel>
                    <!-- Observed Behavior -->
                    <TextBlock Text="Observed Behavior / Description" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <TextBox x:Name="ObservedBox" Background="{DynamicResource BgCardBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" AcceptsReturn="True" TextWrapping="Wrap" Height="100" Margin="0,0,0,16" Padding="10"/>

                    <!-- Expected Behavior -->
                    <TextBlock Text="Expected Behavior (Optional)" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <TextBox x:Name="ExpectedBox" Background="{DynamicResource BgCardBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" AcceptsReturn="True" TextWrapping="Wrap" Height="75" Margin="0,0,0,16" Padding="10"/>

                    <!-- AI Suggestions Box if present -->
                    <Border x:Name="AiContainer" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="🤖 AI Assistance Draft" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="AiNotesBlock" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer / Save -->
        <Grid Grid.Row="2">
            <Button Content="Close &amp; Save Changes" Click="Save_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Grid>
</Window>
