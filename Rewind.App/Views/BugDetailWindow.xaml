<Window x:Class="Rewind.App.Views.BugDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bug Detail &amp; Evidence Review" Height="650" Width="850"
        WindowStartupLocation="CenterScreen" Background="#0D1117" Foreground="#F0F6FC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBox x:Name="TitleBox" Text="Bug Title" FontSize="20" FontWeight="Bold" Background="Transparent" Foreground="#F0F6FC" BorderThickness="0" Margin="0,0,0,4"/>
                <TextBlock x:Name="MetaInfoText" Text="Captured at 12:00:00 • 30.0s clip" FontSize="12" Foreground="#8B949E"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Play Video in Player" Click="PlayVideo_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                <Button Content="Delete Bug" Click="Delete_Click" Style="{StaticResource DangerButton}"/>
            </StackPanel>
        </Grid>

        <!-- Body / Two Column Layout -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Video Player & Preview -->
            <Border Grid.Column="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Media Player with Image fallback -->
                    <Grid Grid.Row="0" Background="#090D13">
                        <MediaElement x:Name="ClipMediaPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" ScrubbingEnabled="True"/>
                        <Image x:Name="ThumbnailImage" Stretch="Uniform" Visibility="Visible"/>
                    </Grid>

                    <!-- Player Controls & Timeline -->
                    <Grid Grid.Row="1" Margin="0,10,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" x:Name="PlayPauseMediaBtn" Content="▶ Play" Click="TogglePlayMedia_Click" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,8,0"/>
                        <Slider Grid.Column="1" x:Name="MediaPositionSlider" Minimum="0" Value="0" VerticalAlignment="Center" ValueChanged="MediaPositionSlider_ValueChanged"/>
                        <TextBlock Grid.Column="2" x:Name="MediaTimeLabel" Text="00:00 / 00:00" FontSize="11" Foreground="#8B949E" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Grid.Row="2">
                        <TextBlock x:Name="ClipPathLabel" Text="Evidence: clip.mp4" FontSize="11" Foreground="#8B949E" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Metadata & QA Report Fields -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Status & Tags -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Status" FontSize="11" Foreground="#8B949E" Margin="0,0,0,4"/>
                            <ComboBox x:Name="StatusCombo" Background="#161B22" Foreground="#FFFFFF" BorderBrush="#30363D">
                                <ComboBoxItem Content="Open" IsSelected="True"/>
                                <ComboBoxItem Content="Verified"/>
                                <ComboBoxItem Content="Fixed"/>
                                <ComboBoxItem Content="Ignored"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Tags" FontSize="11" Foreground="#8B949E" Margin="0,0,0,4"/>
                            <TextBox x:Name="TagsBox" Background="#161B22" Foreground="#FFFFFF" BorderBrush="#30363D" Padding="6,4"/>
                        </StackPanel>
                    </Grid>

                    <!-- Observed Behavior -->
                    <TextBlock Text="Observed Behavior" FontSize="12" FontWeight="SemiBold" Foreground="#F0F6FC" Margin="0,0,0,4"/>
                    <TextBox x:Name="ObservedBox" Background="#161B22" Foreground="#FFFFFF" BorderBrush="#30363D" AcceptsReturn="True" TextWrapping="Wrap" Height="60" Margin="0,0,0,12" Padding="6"/>

                    <!-- Expected Behavior -->
                    <TextBlock Text="Expected Behavior" FontSize="12" FontWeight="SemiBold" Foreground="#F0F6FC" Margin="0,0,0,4"/>
                    <TextBox x:Name="ExpectedBox" Background="#161B22" Foreground="#FFFFFF" BorderBrush="#30363D" AcceptsReturn="True" TextWrapping="Wrap" Height="60" Margin="0,0,0,12" Padding="6"/>

                    <!-- Reproduction Steps -->
                    <TextBlock Text="Reproduction Steps" FontSize="12" FontWeight="SemiBold" Foreground="#F0F6FC" Margin="0,0,0,4"/>
                    <TextBox x:Name="ReproBox" Background="#161B22" Foreground="#FFFFFF" BorderBrush="#30363D" AcceptsReturn="True" TextWrapping="Wrap" Height="80" Margin="0,0,0,12" Padding="6"/>

                    <!-- AI Suggestions Box if present -->
                    <Border x:Name="AiContainer" Background="#1F242C" BorderBrush="#388BFD" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="🤖 AI Assistance Draft" FontWeight="Bold" FontSize="11" Foreground="#58A6FF" Margin="0,0,0,4"/>
                            <TextBlock x:Name="AiNotesBlock" FontSize="11" Foreground="#C9D1D9" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer / Save -->
        <Grid Grid.Row="2">
            <Button Content="Close &amp; Save Changes" Click="Save_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>
