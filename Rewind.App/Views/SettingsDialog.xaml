<Window x:Class="Rewind.App.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings &amp; Capture Profiles" Height="560" Width="600"
        MinHeight="400" MinWidth="480" MaxHeight="800"
        Icon="pack://application:,,,/app.ico"
        WindowStartupLocation="CenterOwner" 
        WindowStyle="None" AllowsTransparency="False"
        Background="{DynamicResource BgPrimaryBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Dialog Header with Title & Close -->
        <Border Grid.Row="0" Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl Template="{StaticResource AvocadoMascotCompact}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="REWIND Studio Preferences" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- Close Button -->
                <Button Grid.Column="2" Click="Cancel_Click" Style="{StaticResource WindowCloseButton}" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="{StaticResource WinCloseGeometry}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Stretch="Uniform" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </Border>

        <!-- Scrollable Settings Body (Prevents Any Screen Overflow, Hidden Visual Scrollbar) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Padding="20,16">
            <StackPanel>
                <!-- Appearance Theme Preference: Color Palette & Dark/Light Mode -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Cinematic Studio Color Theme" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="ColorPaletteCombo" SelectionChanged="ThemeSelection_Changed" Background="{DynamicResource BgCardBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}">
                            <ComboBoxItem Content="🎬 Studio Slate (DaVinci Neutral)" IsSelected="True"/>
                            <ComboBoxItem Content="🌲 Imperial Emerald (Cyber / Matrix)"/>
                            <ComboBoxItem Content="🍷 Velvet Burgundy (Screening Noir)"/>
                            <ComboBoxItem Content="🍯 Amber Obsidian (Film Director Warm)"/>
                            <ComboBoxItem Content="💎 Midnight Sapphire (CleanShot Blue)"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Display Mode" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="DisplayModeCombo" SelectionChanged="ThemeSelection_Changed" Background="{DynamicResource BgCardBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}">
                            <ComboBoxItem Content="🌙 Dark Mode" IsSelected="True"/>
                            <ComboBoxItem Content="☀️ Light Mode"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Buffer Duration -->
                <TextBlock Text="Rolling Buffer Retention (Seconds)" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="BufferDurationSlider" Minimum="15" Maximum="180" Value="60" TickFrequency="15" IsSnapToTickEnabled="True" ValueChanged="BufferDurationSlider_ValueChanged" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Name="BufferDurationValueLabel" Text="60s" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                </Grid>

                <!-- Frame Rate -->
                <TextBlock Text="Capture Target Frame Rate (FPS)" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                <ComboBox x:Name="FpsCombo" Background="{DynamicResource BgCardBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" Margin="0,0,0,14">
                    <ComboBoxItem Content="15 FPS (Recommended for low overhead)" IsSelected="True"/>
                    <ComboBoxItem Content="30 FPS (Smooth animation &amp; UI interactions)"/>
                    <ComboBoxItem Content="60 FPS (High fidelity)"/>
                </ComboBox>

                <!-- Capture Source -->
                <TextBlock Text="Capture Target" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                <ComboBox x:Name="SourceCombo" Background="{DynamicResource BgCardBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" Margin="0,0,0,14">
                    <ComboBoxItem Content="Primary Display (Entire Screen)" IsSelected="True"/>
                    <ComboBoxItem Content="Active Foreground Window"/>
                </ComboBox>

                <!-- Global Hotkey -->
                <TextBlock Text="Global Preservation Hotkey" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="HotkeyBox" Text="Ctrl+Shift+R" IsReadOnly="True" Background="{DynamicResource BgCardBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" Padding="8,5" Margin="0,0,0,14"/>

                <!-- Storage Directory & Usage Visualization -->
                <TextBlock Text="Local Storage Directory &amp; Usage" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="StorageDirBox" IsReadOnly="True" Background="{DynamicResource BgCardBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" Padding="8,5"/>
                    <Button Grid.Column="1" Content="Open Folder" Click="OpenStorageFolder_Click" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                </Grid>
                <ProgressBar x:Name="StorageProgressBar" Height="6" Minimum="0" Maximum="100" Value="15" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BgSecondaryBrush}" BorderThickness="0" Margin="0,0,0,4"/>
                <TextBlock x:Name="StorageUsageLabel" Text="Calculating storage consumption..." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                <!-- Automated Diagnostics & Ollama Settings -->
                <CheckBox x:Name="AiEnabledCheck" IsChecked="True" Margin="0,4,0,8">
                    <StackPanel>
                        <TextBlock Text="Automatic Defect Synthesis &amp; Steps" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Drafts reproduction steps and synthesizes user test cases into professional defect reports." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </CheckBox>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <Grid Margin="0,0,0,3">
                            <TextBlock Text="Ollama Model" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Button Content="↻ Refresh Models" Click="RefreshModels_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Padding="6,2" FontSize="10.5"/>
                        </Grid>
                        <ComboBox x:Name="OllamaModelCombo" Background="{DynamicResource BgCardBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                        <TextBlock x:Name="ModelStatusText" Text="Detecting available local models..." FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="Ollama Host URL" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                        <TextBox x:Name="OllamaHostBox" Text="http://localhost:11434" Background="{DynamicResource BgCardBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" Padding="8,5"/>
                    </StackPanel>
                </Grid>

                <!-- Optional Audio Capture Toggle (PRD Open Decision #4) -->
                <CheckBox x:Name="AudioEnabledCheck" IsChecked="False" Margin="0,4,0,0">
                    <StackPanel>
                        <TextBlock Text="Capture Voice Commentary (Microphone)" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Records tester voice notes during reproduction alongside screen history." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </CheckBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Sticky Footer -->
        <Border Grid.Row="2" Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <Button Content="Purge Old Buffer" Click="PurgeBuffer_Click" Style="{StaticResource DangerButton}" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="14,7"/>
                    <Button Content="Save Preferences" Click="Save_Click" Style="{StaticResource PrimaryButton}" Padding="16,7"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
