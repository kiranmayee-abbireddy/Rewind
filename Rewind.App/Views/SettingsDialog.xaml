<Window x:Class="Rewind.App.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings &amp; Capture Profiles" Height="490" Width="560"
        WindowStartupLocation="CenterScreen" Background="#0B0E14" Foreground="#F3F6FC">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="REWIND Configuration" FontSize="20" FontWeight="Bold" Foreground="#F3F6FC"/>
            <TextBlock Text="Adjust rolling buffer duration, video profile, and hotkey preferences." FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <!-- Buffer Duration -->
            <TextBlock Text="Rolling Buffer Retention (Seconds)" FontSize="12.5" FontWeight="SemiBold" Foreground="#F3F6FC" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="BufferDurationSlider" Minimum="15" Maximum="180" Value="60" TickFrequency="15" IsSnapToTickEnabled="True" ValueChanged="BufferDurationSlider_ValueChanged" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="BufferDurationValueLabel" Text="60s" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#388BFD"/>
            </Grid>

            <!-- Frame Rate -->
            <TextBlock Text="Capture Target Frame Rate (FPS)" FontSize="12.5" FontWeight="SemiBold" Foreground="#F3F6FC" Margin="0,0,0,4"/>
            <ComboBox x:Name="FpsCombo" Background="#111620" Foreground="#F3F6FC" BorderBrush="#253043" Margin="0,0,0,14">
                <ComboBoxItem Content="15 FPS (Recommended for low overhead)" IsSelected="True"/>
                <ComboBoxItem Content="30 FPS (Smooth animation &amp; UI interactions)"/>
                <ComboBoxItem Content="60 FPS (High fidelity)"/>
            </ComboBox>

            <!-- Capture Source -->
            <TextBlock Text="Capture Target" FontSize="12.5" FontWeight="SemiBold" Foreground="#F3F6FC" Margin="0,0,0,4"/>
            <ComboBox x:Name="SourceCombo" Background="#111620" Foreground="#F3F6FC" BorderBrush="#253043" Margin="0,0,0,14">
                <ComboBoxItem Content="Primary Display (Entire Screen)" IsSelected="True"/>
                <ComboBoxItem Content="Active Foreground Window"/>
            </ComboBox>

            <!-- Global Hotkey -->
            <TextBlock Text="Global Preservation Hotkey" FontSize="12.5" FontWeight="SemiBold" Foreground="#F3F6FC" Margin="0,0,0,4"/>
            <TextBox x:Name="HotkeyBox" Text="Ctrl+Shift+R" IsReadOnly="True" Background="#111620" Foreground="#F3F6FC" BorderBrush="#253043" Padding="8,5" Margin="0,0,0,14"/>

            <!-- Storage Directory & Usage Visualization -->
            <TextBlock Text="Local Storage Directory &amp; Usage" FontSize="12.5" FontWeight="SemiBold" Foreground="#F3F6FC" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="StorageDirBox" IsReadOnly="True" Background="#111620" Foreground="#F3F6FC" BorderBrush="#253043" Padding="8,5"/>
                <Button Grid.Column="1" Content="Open Folder" Click="OpenStorageFolder_Click" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
            </Grid>
            <ProgressBar x:Name="StorageProgressBar" Height="6" Minimum="0" Maximum="100" Value="15" Foreground="#388BFD" Background="#171F2C" BorderThickness="0" Margin="0,0,0,4"/>
            <TextBlock x:Name="StorageUsageLabel" Text="Calculating storage consumption..." FontSize="11" Foreground="#94A3B8" Margin="0,0,0,14"/>

            <!-- AI Assistant & Ollama Settings -->
            <CheckBox x:Name="AiEnabledCheck" IsChecked="True" Margin="0,4,0,8">
                <StackPanel>
                    <TextBlock Text="Enable AI Bug Report Assistant" FontWeight="SemiBold" Foreground="#F3F6FC"/>
                    <TextBlock Text="Drafts reproduction steps and synthesizes user test cases into professional titles." FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </CheckBox>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                    <TextBlock Text="Ollama Model" FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,3"/>
                    <ComboBox x:Name="OllamaModelCombo" Background="#111620" Foreground="#F3F6FC" BorderBrush="#253043">
                        <ComboBoxItem Content="gemma3:1b (Fast, Recommended)" IsSelected="True"/>
                        <ComboBoxItem Content="qwen3:4b"/>
                        <ComboBoxItem Content="llama3:latest"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                    <TextBlock Text="Ollama Host URL" FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,3"/>
                    <TextBox x:Name="OllamaHostBox" Text="http://localhost:11434" Background="#111620" Foreground="#F3F6FC" BorderBrush="#253043" Padding="8,5"/>
                </StackPanel>
            </Grid>

            <!-- Optional Audio Capture Toggle (PRD Open Decision #4) -->
            <CheckBox x:Name="AudioEnabledCheck" IsChecked="False" Margin="0,4,0,0">
                <StackPanel>
                    <TextBlock Text="Capture Voice Commentary (Microphone)" FontWeight="SemiBold" Foreground="#F3F6FC"/>
                    <TextBlock Text="Records tester voice notes during reproduction alongside screen history." FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </CheckBox>
        </StackPanel>

        <!-- Footer -->
        <Grid Grid.Row="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Purge Old Buffer" Click="PurgeBuffer_Click" Style="{StaticResource DangerButton}" Margin="0,0,10,0"/>
                <Button Content="Save Settings" Click="Save_Click" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
