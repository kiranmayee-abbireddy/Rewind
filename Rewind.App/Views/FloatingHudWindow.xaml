<Window x:Class="Rewind.App.Views.FloatingHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="REWIND Companion"
        Width="92" Height="100"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Grid>
        <!-- MODE 1: Secret Peeking Mascot (Docked half-out against the screen edge with side-glancing cute peeking face) -->
        <Border x:Name="PeekingMascotCapsule"
                Width="52" Height="60"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="18"
                Cursor="Hand"
                Background="Transparent"
                PreviewMouseLeftButtonDown="PeekingMascot_PreviewMouseLeftButtonDown"
                MouseMove="PeekingMascot_MouseMove"
                PreviewMouseLeftButtonUp="PeekingMascot_PreviewMouseLeftButtonUp"
                MouseRightButtonUp="PeekingMascot_MouseRightButtonUp"
                ToolTip="REWIND Companion (Watching secretly from edge) • Click to open quick options • Drag along edge • Right-click to hide">
            <Grid x:Name="MascotContainer" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.85">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="MascotPeekScale" ScaleX="1" ScaleY="1"/>
                        <RotateTransform x:Name="MascotPeekRotate" Angle="0"/>
                    </TransformGroup>
                </Grid.RenderTransform>

                <!-- Soft Emerald Aura Glow -->
                <Ellipse Width="50" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#4010B981" Offset="0"/>
                            <GradientStop Color="#0010B981" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Living Animated Avocado Mascot with sneaky edge side glance & blink -->
                <Viewbox Width="50" Height="58" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <ContentControl Template="{StaticResource AvocadoMascotPeeking}"/>
                </Viewbox>
            </Grid>
        </Border>

        <!-- MODE 2: Floating Quick Ball Orbit (Fully Straight Mascot with Floating Option Circles and NO background container) -->
        <Grid x:Name="QuickBallCapsule"
              Visibility="Collapsed"
              Background="Transparent"
              Width="220" Height="210"
              MouseLeftButtonDown="QuickBall_MouseDown"
              Cursor="SizeAll"
              ToolTip="Drag anywhere to move • Click center mascot to dock back secretly to edge">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="QuickBallScale" ScaleX="1.0" ScaleY="1.0" CenterX="110" CenterY="105"/>
                </TransformGroup>
            </Grid.RenderTransform>

            <!-- Center: Perfectly Straight Mascot (Click to retract back to edge) -->
            <Button Click="CenterMascot_Click"
                    Background="Transparent" BorderThickness="0" Padding="0"
                    Width="64" Height="72"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Cursor="Hand" ToolTip="Click to dock Guac back to screen edge">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Button.Template>
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Width="62" Height="62" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#5510B981" Offset="0"/>
                                <GradientStop Color="#0010B981" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Viewbox Width="60" Height="68" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <ContentControl Template="{StaticResource AvocadoMascot}"/>
                    </Viewbox>
                </Grid>
            </Button>

            <!-- Floating Circle 1: Running Buffer Monospace Timer (Top Center) -->
            <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="9,4"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.55"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="REC" FontWeight="Bold" FontSize="10.5" Foreground="{DynamicResource DangerBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="BufferTimeText" Text="00:00" FontFamily="Consolas, monospace" FontWeight="Bold" FontSize="10.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Floating Circle 2: ⚡ Preserve Evidence Orb (Right) -->
            <Button x:Name="PreserveBtn" Click="PreserveButton_Click"
                    Style="{StaticResource QuickBallCircleButton}"
                    Background="{DynamicResource GoldBrush}" BorderBrush="{DynamicResource GoldBrush}"
                    Width="36" Height="36"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                    ToolTip="Preserve Bug • Capture recent buffer evidence">
                <Path Data="{StaticResource LightningBoltGeometry}" Fill="#FFFFFF" Stretch="Uniform" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>

            <!-- Floating Circle 3: ⏸ / ▶ Pause & Resume Orb (Left) -->
            <Button x:Name="PauseResumeBtn" Click="PauseResumeButton_Click"
                    Style="{StaticResource QuickBallCircleButton}"
                    Width="34" Height="34"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"
                    ToolTip="Pause / Resume Capture">
                <Path x:Name="PauseResumeIcon" Data="{StaticResource PauseGeometry}" Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>

            <!-- Floating Circle 4: 📑 Dashboard Orb (Bottom Left) -->
            <Button Click="OpenMain_Click"
                    Style="{StaticResource QuickBallCircleButton}"
                    Width="32" Height="32"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="38,0,0,12"
                    ToolTip="Open REWIND Dashboard">
                <Path Data="{StaticResource WinExpandGeometry}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" Stretch="Uniform" Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>

            <!-- Floating Circle 5: ✕ Retract / Dock to Edge Orb (Bottom Right) -->
            <Button Click="DockToEdge_Click"
                    Style="{StaticResource QuickBallCircleButton}"
                    Width="32" Height="32"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,38,12"
                    ToolTip="Dock Mascot Secretly to Edge">
                <Path Data="{StaticResource WinMinimizeGeometry}" Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" Width="11" Height="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
        </Grid>
    </Grid>
</Window>
