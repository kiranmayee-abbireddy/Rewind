<Window x:Class="Rewind.App.Views.TimelineEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preserve Bug — Time-Range Selection" Height="420" Width="680"
        WindowStartupLocation="CenterScreen" Background="#0D1117" Foreground="#F0F6FC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Preserve Bug From Screen History" FontSize="18" FontWeight="Bold" Foreground="#F0F6FC"/>
            <TextBlock Text="Select the relevant time interval prior to bug discovery to save as immutable evidence." FontSize="12" Foreground="#8B949E" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Bug Title Field -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Bug Title:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/>
            <TextBox Grid.Column="1" x:Name="BugTitleBox" Background="#161B22" Foreground="#FFFFFF" BorderBrush="#30363D" Padding="8,6" FontSize="13" Text="Discovered defect in active view"/>
        </Grid>

        <!-- Preview & Scrubber Area -->
        <Border Grid.Row="2" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Thumbnail Preview with Redaction Canvas -->
                <Border Grid.Row="0" Background="#090D13" CornerRadius="6" Margin="0,0,0,12" ClipToBounds="True">
                    <Grid x:Name="PreviewContainer">
                        <Image x:Name="PreviewImage" Stretch="Uniform"/>
                        <Canvas x:Name="RedactionCanvas" Background="Transparent" MouseDown="RedactionCanvas_MouseDown" MouseMove="RedactionCanvas_MouseMove" MouseUp="RedactionCanvas_MouseUp" Cursor="Cross"/>
                    </Grid>
                </Border>
                <Grid Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="8">
                    <Button Content="Clear Redactions" Click="ClearRedactions_Click" Style="{StaticResource SecondaryButton}" Padding="6,2" FontSize="10" Opacity="0.85"/>
                </Grid>

                <!-- Timeline Dual Sliders & Playback Controls -->
                <StackPanel Grid.Row="1">
                    <Grid Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="PlayPreviewBtn" Content="▶ Play" Click="PlayPreview_Click" Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11" Margin="0,0,8,0"/>
                            <TextBlock x:Name="RangeLabel" Text="Preserving 30.0s of history" FontSize="12" FontWeight="SemiBold" Foreground="#58A6FF" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TimeBoundsLabel" Text="00:00 → 00:00" HorizontalAlignment="Right" FontSize="11" Foreground="#8B949E" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Start Slider -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Start Time:" FontSize="11" Foreground="#8B949E" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" x:Name="StartSlider" Minimum="0" Maximum="60" Value="0" ValueChanged="Slider_ValueChanged" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" x:Name="StartValueLabel" Text="00:00" HorizontalAlignment="Right" FontSize="11" Foreground="#F0F6FC" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- End Slider -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="End Time:" FontSize="11" Foreground="#8B949E" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" x:Name="EndSlider" Minimum="0" Maximum="60" Value="60" ValueChanged="Slider_ValueChanged" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" x:Name="EndValueLabel" Text="00:00" HorizontalAlignment="Right" FontSize="11" Foreground="#F0F6FC" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Quick Preset Selectors -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                        <TextBlock Text="Quick Presets: " FontSize="11" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button Content="Last 15s" Click="Preset15_Click" Style="{StaticResource SecondaryButton}" Padding="6,2" FontSize="11" Margin="0,0,4,0"/>
                        <Button Content="Last 30s" Click="Preset30_Click" Style="{StaticResource SecondaryButton}" Padding="6,2" FontSize="11" Margin="0,0,4,0"/>
                        <Button Content="Last 60s" Click="Preset60_Click" Style="{StaticResource SecondaryButton}" Padding="6,2" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer / Actions -->
        <Grid Grid.Row="3">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="AiAssistCheck" IsChecked="True" VerticalAlignment="Center">
                    <TextBlock Text="Draft AI suggestions from clip" Foreground="#C9D1D9" FontSize="12"/>
                </CheckBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                <Button x:Name="PreserveConfirmBtn" Content="✔ Save Bug Evidence" Click="Save_Click" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
