<Window x:Class="Rewind.App.Views.TimelineEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preserve Bug — Time-Range Selection" Height="720" Width="1040"
        MinHeight="620" MinWidth="880" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen" Background="#0B0E14" Foreground="#F3F6FC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource LogoOrbGradient}" Margin="0,0,12,0">
                    <Path Data="{StaticResource VideoCameraGeometry}" Fill="#FFFFFF" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Preserve Bug Evidence" FontSize="20" FontWeight="Bold" Foreground="#F3F6FC"/>
                    <TextBlock Text="Review recorded frames, adjust start/end boundaries, and apply redaction rectangles before saving." FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Bug Title & Case Context Fields -->
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Bug Title:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#F3F6FC" FontSize="13"/>
                <TextBox Grid.Column="1" x:Name="BugTitleBox" Background="#111620" Foreground="#F3F6FC" BorderBrush="#253043" Padding="10,7" FontSize="13" Text="" Tag="Enter bug title (if provided, this will be preserved)"/>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Test Case / Notes:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#94A3B8" FontSize="12"/>
                <TextBox Grid.Column="1" x:Name="TestCaseBox" Background="#111620" Foreground="#F3F6FC" BorderBrush="#253043" Padding="10,7" FontSize="12" Text="" Tag="e.g. When opened the meeting details tab in split view the member names in project info gets cut"/>
            </Grid>
        </StackPanel>

        <!-- Preview & Scrubber Area -->
        <Border Grid.Row="2" Background="#111620" BorderBrush="#253043" BorderThickness="1.5" CornerRadius="10" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Thumbnail Preview with Redaction Canvas -->
                <Border Grid.Row="0" Background="#07090E" CornerRadius="8" Margin="0,0,0,12" ClipToBounds="True" MinHeight="340" BorderBrush="#1F2937" BorderThickness="1">
                    <Grid x:Name="PreviewContainer" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Canvas x:Name="RedactionCanvas" Background="Transparent" MouseDown="RedactionCanvas_MouseDown" MouseMove="RedactionCanvas_MouseMove" MouseUp="RedactionCanvas_MouseUp" Cursor="Cross"/>
                    </Grid>
                </Border>
                <Grid Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="8">
                    <Button Content="Clear Redactions" Click="ClearRedactions_Click" Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11" Opacity="0.9"/>
                </Grid>

                <!-- Timeline Dual Sliders & Playback Controls -->
                <StackPanel Grid.Row="1">
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="PlayPreviewBtn" Content="▶ Play" Click="PlayPreview_Click" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11.5" Margin="0,0,10,0"/>
                            <TextBlock x:Name="RangeLabel" Text="Preserving 30.0s of history" FontSize="12.5" FontWeight="SemiBold" Foreground="#388BFD" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TimeBoundsLabel" Text="00:00 → 00:00" HorizontalAlignment="Right" FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Start Slider -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Start Time:" FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" x:Name="StartSlider" Minimum="0" Maximum="60" Value="0" ValueChanged="Slider_ValueChanged" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" x:Name="StartValueLabel" Text="00:00" HorizontalAlignment="Right" FontSize="11.5" Foreground="#F3F6FC" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- End Slider -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="End Time:" FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" x:Name="EndSlider" Minimum="0" Maximum="60" Value="60" ValueChanged="Slider_ValueChanged" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" x:Name="EndValueLabel" Text="00:00" HorizontalAlignment="Right" FontSize="11.5" Foreground="#F3F6FC" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Quick Preset Selectors -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                        <TextBlock Text="Quick Presets: " FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="Last 15s" Click="Preset15_Click" Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11" Margin="0,0,6,0"/>
                        <Button Content="Last 30s" Click="Preset30_Click" Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11" Margin="0,0,6,0"/>
                        <Button Content="Last 60s" Click="Preset60_Click" Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer / Actions -->
        <Grid Grid.Row="3">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="AiAssistCheck" IsChecked="True" VerticalAlignment="Center">
                    <TextBlock Text="Draft AI suggestions &amp; reproduction steps from clip" Foreground="#F3F6FC" FontSize="12.5"/>
                </CheckBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                <Button x:Name="PreserveConfirmBtn" Content="✔ Save Bug Evidence" Click="Save_Click" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
