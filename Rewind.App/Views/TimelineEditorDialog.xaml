<Window x:Class="Rewind.App.Views.TimelineEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preserve Bug — Time-Range Selection" Height="420" Width="680"
        WindowStartupLocation="CenterScreen" Background="#0D1117" Foreground="#F0F6FC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Preserve Bug From Screen History" FontSize="18" FontWeight="Bold" Foreground="#F0F6FC"/>
            <TextBlock Text="Select the relevant time interval prior to bug discovery to save as immutable evidence." FontSize="12" Foreground="#8B949E" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Bug Title Field -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Bug Title:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/>
            <TextBox Grid.Column="1" x:Name="BugTitleBox" Background="#161B22" Foreground="#FFFFFF" BorderBrush="#30363D" Padding="8,6" FontSize="13" Text="Discovered defect in active view"/>
        </Grid>

        <!-- Preview & Scrubber Area -->
        <Border Grid.Row="2" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Thumbnail Preview -->
                <Border Grid.Row="0" Background="#090D13" CornerRadius="6" Margin="0,0,0,12">
                    <Image x:Name="PreviewImage" Stretch="Uniform"/>
                </Border>

                <!-- Timeline Sliders -->
                <StackPanel Grid.Row="1">
                    <Grid Margin="0,0,0,6">
                        <TextBlock x:Name="RangeLabel" Text="Preserving last 30.0s of history" FontSize="12" FontWeight="SemiBold" Foreground="#58A6FF"/>
                        <TextBlock x:Name="TimeBoundsLabel" Text="00:00 → 00:00" HorizontalAlignment="Right" FontSize="11" Foreground="#8B949E"/>
                    </Grid>

                    <TextBlock Text="Clip Start Offset (seconds before now):" FontSize="11" Foreground="#8B949E"/>
                    <Slider x:Name="StartSlider" Minimum="5" Maximum="60" Value="30" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged" Margin="0,2,0,8"/>

                    <!-- Quick Preset Selectors -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                        <TextBlock Text="Quick Presets: " FontSize="11" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button Content="15s" Click="Preset15_Click" Style="{StaticResource SecondaryButton}" Padding="6,2" FontSize="11" Margin="0,0,4,0"/>
                        <Button Content="30s" Click="Preset30_Click" Style="{StaticResource SecondaryButton}" Padding="6,2" FontSize="11" Margin="0,0,4,0"/>
                        <Button Content="60s" Click="Preset60_Click" Style="{StaticResource SecondaryButton}" Padding="6,2" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer / Actions -->
        <Grid Grid.Row="3">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="AiAssistCheck" IsChecked="True" VerticalAlignment="Center">
                    <TextBlock Text="Draft AI suggestions from clip" Foreground="#C9D1D9" FontSize="12"/>
                </CheckBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                <Button x:Name="PreserveConfirmBtn" Content="✔ Save Bug Evidence" Click="Save_Click" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
