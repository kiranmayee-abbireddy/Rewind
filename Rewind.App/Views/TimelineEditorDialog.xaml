<Window x:Class="Rewind.App.Views.TimelineEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preserve Bug — Time-Range Selection" Height="720" Width="1040" Icon="pack://application:,,,/app.ico"
        MinHeight="600" MinWidth="850" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None" AllowsTransparency="False"
        Background="{DynamicResource BgPrimaryBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar with Avocado Mascot -->
        <Border Grid.Row="0" Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl Template="{StaticResource AvocadoMascotCompact}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Preserve Bug Evidence • Frame &amp; Boundary Editor" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Window Close Button -->
                <Button Grid.Column="2" Click="Cancel_Click" Style="{StaticResource WindowCloseButton}" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="{StaticResource WinCloseGeometry}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Stretch="Uniform" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </Border>

        <!-- Main Body -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Description -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Time-Range Selection &amp; Redaction" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Review recorded frames, adjust start/end boundaries, and apply redaction rectangles before saving." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Bug Title & Case Context Fields -->
            <StackPanel Grid.Row="1" Margin="0,0,0,14">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Bug Title:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                    <TextBox Grid.Column="1" x:Name="BugTitleBox" Background="{DynamicResource BgCardBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" Padding="10,7" FontSize="13" Text="" Tag="Enter bug title (if provided, this will be preserved)"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Test Case / Notes:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBox Grid.Column="1" x:Name="TestCaseBox" Background="{DynamicResource BgCardBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" Padding="10,7" FontSize="12" Text="" Tag="e.g. When opened the meeting details tab in split view the member names in project info gets cut"/>
                </Grid>
            </StackPanel>

        <!-- Preview & Scrubber Area -->
        <Border Grid.Row="2" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" CornerRadius="10" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Thumbnail Preview with Redaction Canvas -->
                <Border Grid.Row="0" Background="{DynamicResource BgPrimaryBrush}" CornerRadius="8" Margin="0,0,0,12" ClipToBounds="True" MinHeight="340" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid x:Name="PreviewContainer" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Canvas x:Name="RedactionCanvas" Background="Transparent" MouseDown="RedactionCanvas_MouseDown" MouseMove="RedactionCanvas_MouseMove" MouseUp="RedactionCanvas_MouseUp" Cursor="Cross"/>
                    </Grid>
                </Border>
                <Grid Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="8">
                    <Button Content="Clear Redactions" Click="ClearRedactions_Click" Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11" Opacity="0.9"/>
                </Grid>

                <!-- Timeline Dual Sliders & Playback Controls -->
                <StackPanel Grid.Row="1">
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="PlayPreviewBtn" Content="▶ Play" Click="PlayPreview_Click" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11.5" Margin="0,0,10,0"/>
                            <TextBlock x:Name="RangeLabel" Text="Preserving 30.0s of history" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TimeBoundsLabel" Text="00:00 → 00:00" HorizontalAlignment="Right" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Start Slider -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Start Time:" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" x:Name="StartSlider" Minimum="0" Maximum="60" Value="0" ValueChanged="Slider_ValueChanged" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" x:Name="StartValueLabel" Text="00:00" HorizontalAlignment="Right" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- End Slider -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="End Time:" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" x:Name="EndSlider" Minimum="0" Maximum="60" Value="60" ValueChanged="Slider_ValueChanged" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" x:Name="EndValueLabel" Text="00:00" HorizontalAlignment="Right" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Quick Preset Selectors -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                        <TextBlock Text="Quick Presets: " FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="Last 15s" Click="Preset15_Click" Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11" Margin="0,0,6,0"/>
                        <Button Content="Last 30s" Click="Preset30_Click" Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11" Margin="0,0,6,0"/>
                        <Button Content="Last 60s" Click="Preset60_Click" Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer / Actions -->
        <Grid Grid.Row="3">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="AiAssistCheck" IsChecked="True" VerticalAlignment="Center">
                    <TextBlock Text="Auto-generate reproduction steps &amp; defect notes" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5"/>
                </CheckBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                <Button x:Name="PreserveConfirmBtn" Content="✔ Save Bug Evidence" Click="Save_Click" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Grid>
</Window>
