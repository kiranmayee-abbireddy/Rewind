                    <Rectangle Canvas.Left="2" Canvas.Top="10" Width="30" Height="4" RadiusX="2" RadiusY="2" Fill="{DynamicResource BorderBrush}"/>
                    <Path Data="M 11,10 L 11,6 L 21,6 L 21,10" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                    <Path Data="M 17,24 L 21,29 L 13,29 Z" Fill="{DynamicResource AccentBrush}" Opacity="0.6"/>
