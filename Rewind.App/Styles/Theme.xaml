<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Nordic Minimalist Cinematic Studio Palette (Slate, Titanium, Pure Chalk & Quiet Accents) -->
    <Color x:Key="BgPrimaryColor">#121418</Color>
    <Color x:Key="BgSecondaryColor">#181B20</Color>
    <Color x:Key="BgCardColor">#1E2229</Color>
    <Color x:Key="BorderColor">#2A303C</Color>
    <Color x:Key="BorderFocusColor">#4E5A6E</Color>
    <Color x:Key="TextPrimaryColor">#F3F5F7</Color>
    <Color x:Key="TextSecondaryColor">#8E98A8</Color>
    <Color x:Key="AccentColor">#E2E8F0</Color>
    <Color x:Key="ButtonForegroundColor">#0F172A</Color>
    <Color x:Key="GoldColor">#E5A93C</Color>
    <Color x:Key="DangerColor">#E05252</Color>
    <Color x:Key="SuccessColor">#38A169</Color>
    <Color x:Key="WarningColor">#E5A93C</Color>

    <SolidColorBrush x:Key="BgPrimaryBrush" Color="{StaticResource BgPrimaryColor}" />
    <SolidColorBrush x:Key="BgSecondaryBrush" Color="{StaticResource BgSecondaryColor}" />
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderFocusBrush" Color="{StaticResource BorderFocusColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{StaticResource ButtonForegroundColor}" />
    <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource GoldColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />

    <!-- Nordic Cinematic Subtle Gradient Brushes -->
    <LinearGradientBrush x:Key="PrimaryAccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F1F5F9" Offset="0"/>
        <GradientStop Color="#CBD5E1" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LogoOrbGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#94A3B8" Offset="0"/>
        <GradientStop Color="#475569" Offset="0.5"/>
        <GradientStop Color="#1E293B" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GoldOrbGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FCD34D" Offset="0"/>
        <GradientStop Color="#F59E0B" Offset="0.6"/>
        <GradientStop Color="#B45309" Offset="1"/>
    </LinearGradientBrush>

    <!-- Devin-Style Architectural Precision Grid / Geometric Line Pattern Brush -->
    <VisualBrush x:Key="DevinGridPatternBrush" TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute">
        <VisualBrush.Visual>
            <Canvas Width="24" Height="24" Background="Transparent">
                <Line X1="0" Y1="0" X2="24" Y2="0" Stroke="{DynamicResource BorderBrush}" StrokeThickness="0.6" Opacity="0.35"/>
                <Line X1="0" Y1="0" X2="0" Y2="24" Stroke="{DynamicResource BorderBrush}" StrokeThickness="0.6" Opacity="0.35"/>
                <!-- Subtle intersection dot -->
                <Rectangle Width="1.2" Height="1.2" Canvas.Left="-0.6" Canvas.Top="-0.6" Fill="{DynamicResource AccentBrush}" Opacity="0.25"/>
            </Canvas>
        </VisualBrush.Visual>
    </VisualBrush>

    <!-- Vector Icons Geometries -->
    <Geometry x:Key="RewindArrowsGeometry">M13,6 L4,12 L13,18 L13,13 L21,18 L21,6 L13,11 Z</Geometry>
    <Geometry x:Key="LightningBoltGeometry">M13,2 L4,14 L11,14 L9,22 L20,10 L13,10 Z</Geometry>
    <Geometry x:Key="VideoCameraGeometry">M4,6 C2.89,6 2,6.89 2,8 L2,16 C2,17.11 2.89,18 4,18 L14,18 C15.11,18 16,17.11 16,16 L16,13.5 L20,17.5 C20.55,18.05 21.5,17.66 21.5,16.88 L21.5,7.12 C21.5,6.34 20.55,5.95 20,6.5 L16,10.5 L16,8 C16,6.89 15.11,6 4,6 Z</Geometry>
    <Geometry x:Key="ShieldCheckGeometry">M12,1 L3,5 L3,11 C3,16.55 6.84,21.74 12,23 C17.16,21.74 21,16.55 21,11 L21,5 L12,1 Z M10,17 L5.5,12.5 L6.91,11.09 L10,14.17 L17.09,7.09 L18.5,8.5 L10,17 Z</Geometry>
    <Geometry x:Key="GearGeometry">M12,15.5 A3.5,3.5 0 0 1 8.5,12 A3.5,3.5 0 0 1 12,8.5 A3.5,3.5 0 0 1 15.5,12 A3.5,3.5 0 0 1 12,15.5 M19.43,12.97 C19.47,12.65 19.5,12.33 19.5,12 C19.5,11.67 19.47,11.34 19.43,11 L21.54,9.37 C21.73,9.22 21.78,8.95 21.66,8.73 L19.66,5.27 C19.54,5.05 19.27,4.97 19.05,5.05 L16.56,6.05 C16.04,5.65 15.48,5.32 14.87,5.07 L14.49,2.42 C14.46,2.18 14.25,2 14,2 L10,2 C9.75,2 9.54,2.18 9.51,2.42 L9.13,5.07 C8.52,5.32 7.96,5.66 7.44,6.05 L4.95,5.05 C4.73,4.96 4.46,5.05 4.34,5.27 L2.34,8.73 C2.21,8.95 2.27,9.22 2.46,9.37 L4.57,11 C4.53,11.34 4.5,11.67 4.5,12 C4.5,12.33 4.53,12.65 4.57,12.97 L2.46,14.63 C2.27,14.78 2.21,15.05 2.34,15.27 L4.34,18.73 C4.46,18.95 4.73,19.03 4.95,18.95 L7.44,17.95 C7.96,18.34 8.52,18.68 9.13,18.93 L9.51,21.58 C9.54,21.82 9.75,22 10,22 L14,22 C14.25,22 14.46,21.82 14.49,21.58 L14.87,18.93 C15.48,18.68 16.04,18.34 16.56,17.95 L19.05,18.95 C19.27,19.04 19.54,18.95 19.66,18.73 L21.66,15.27 C21.78,15.05 21.73,14.78 21.54,14.63 L19.43,12.97 Z</Geometry>
    <Geometry x:Key="PauseGeometry">M6,4 L10,4 L10,20 L6,20 Z M14,4 L18,4 L18,20 L14,20 Z</Geometry>
    <Geometry x:Key="PlayGeometry">M8,5 L19,12 L8,19 Z</Geometry>
    <Geometry x:Key="PlusGeometry">M19,13 H13 V19 H11 V13 H5 V11 H11 V5 H13 V11 H19 V13 Z</Geometry>
    <Geometry x:Key="TrashGeometry">M6,19 C6,20.1 6.9,21 8,21 H16 C17.1,21 18,20.1 18,19 V7 H6 V19 Z M19,4 H15.5 L14.5,3 H9.5 L8.5,4 H5 V6 H19 V4 Z</Geometry>
    <!-- Sleek Modern Theme Toggle Geometries (Standard Solid 24x24 Vector Geometries) -->
    <Geometry x:Key="SunGeometry">M12,7 A5,5 0 1,0 12,17 A5,5 0 1,0 12,7 Z M11,1 L13,1 L13,4 L11,4 Z M11,20 L13,20 L13,23 L11,23 Z M1,11 L4,11 L4,13 L1,13 Z M20,11 L23,11 L23,13 L20,13 Z M4.93,3.51 L6.34,2.1 L8.46,4.22 L7.05,5.64 Z M15.54,18.36 L16.95,16.95 L19.07,19.07 L17.66,20.49 Z M2.1,17.66 L3.51,19.07 L5.64,16.95 L4.22,15.54 Z M16.95,7.05 L18.36,5.64 L20.49,7.76 L19.07,9.17 Z</Geometry>
    <Geometry x:Key="MoonGeometry">M12.3,2 C6.9,2.6 2.8,7.2 2.8,12.8 C2.8,18.9 7.8,23.9 13.9,23.9 C18.5,23.9 22.4,21 23.7,16.9 C20.9,17.9 17.6,17.3 15.3,15 C13,12.7 12.4,9.4 13.4,6.6 C13,5 12.6,3.5 12.3,2 Z</Geometry>

    <!-- Crisp Professional Title Bar Window Control Geometries -->
    <Geometry x:Key="WinMinimizeGeometry">M0,5 L10,5 L10,6.2 L0,6.2 Z</Geometry>
    <Geometry x:Key="WinMaximizeGeometry">M1,1 L9,1 L9,9 L1,9 Z M0,0 L10,0 L10,10 L0,10 Z</Geometry>
    <Geometry x:Key="WinRestoreGeometry">M2,0 L10,0 L10,8 L8,8 L8,10 L0,10 L0,2 L2,2 Z M3,1 L3,2 L8,2 L8,7 L9,7 L9,1 Z M1,3 L1,9 L7,9 L7,3 Z</Geometry>
    <Geometry x:Key="WinCloseGeometry">M0.7,0 L5,4.3 L9.3,0 L10,0.7 L5.7,5 L10,9.3 L9.3,10 L5,5.7 L0.7,10 L0,9.3 L4.3,5 L0,0.7 Z</Geometry>
    <Geometry x:Key="WinHudPipetteGeometry">M12,2 C6.5,2 2,6.5 2,12 C2,17.5 6.5,22 12,22 C17.5,22 22,17.5 22,12 C22,6.5 17.5,2 12,2 Z M12,5 C14.5,5 17.5,8 17.5,12 C17.5,16 15,19 12,19 C9,19 6.5,16 6.5,12 C6.5,8 9.5,5 12,5 Z M12,9 A3,3 0 1,0 12,15 A3,3 0 1,0 12,9 Z</Geometry>
    <Geometry x:Key="SidebarLeftGeometry">M3,3 L21,3 L21,21 L3,21 Z M8,5 L5,5 L5,19 L8,19 Z M10,5 L19,5 L19,19 L10,19 Z</Geometry>
    <Geometry x:Key="SidebarRightGeometry">M3,3 L21,3 L21,21 L3,21 Z M16,5 L19,5 L19,19 L16,19 Z M5,5 L14,5 L14,19 L5,19 Z</Geometry>
    <Geometry x:Key="SidebarHideGeometry">M3,3 L21,3 L21,21 L3,21 Z M5,5 L19,5 L19,19 L5,19 Z</Geometry>

    <!-- Adorable Borderless Avocado QA Mascot ("Guac" with QA headset and Living Animation) -->
    <ControlTemplate x:Key="AvocadoMascot">
        <Grid Width="38" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.9">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="MascotScale" ScaleX="1.0" ScaleY="1.0"/>
                    <RotateTransform x:Name="MascotRotate" Angle="0"/>
                </TransformGroup>
            </Grid.RenderTransform>

            <!-- Organic Pear-shaped Body (Rich Emerald with Subtle Drop Glow) -->
            <Path Data="M 19,6 C 27,6 32,13 32,24 C 32,35 27,43 19,43 C 11,43 6,35 6,24 C 6,13 11,6 19,6 Z">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#0D5F47" Offset="0"/>
                        <GradientStop Color="#064E3B" Offset="1"/>
                    </LinearGradientBrush>
                </Path.Fill>
                <Path.Effect>
                    <DropShadowEffect Color="#043226" BlurRadius="4" ShadowDepth="1" Opacity="0.4"/>
                </Path.Effect>
            </Path>

            <!-- Avocado Inner Flesh (Soft Creamy Honeydew/Lime Jade) -->
            <Path Data="M 19,9 C 25,9 29.5,15 29.5,24 C 29.5,33 25.5,40 19,40 C 12.5,40 8.5,33 8.5,24 C 8.5,15 13,9 19,9 Z">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#D1FAE5" Offset="0"/>
                        <GradientStop Color="#A7F3D0" Offset="0.5"/>
                        <GradientStop Color="#6EE7B7" Offset="1"/>
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>

            <!-- Cute QA Headset Arc -->
            <Path Data="M 7,23 C 7,11 31,11 31,23" Stroke="#10B981" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.85"/>
            <!-- Left Earpiece -->
            <Border Width="4" Height="7" CornerRadius="2" Background="#064E3B" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,4,0,0"/>
            <!-- Right Earpiece -->
            <Border Width="4" Height="7" CornerRadius="2" Background="#064E3B" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,4,5,0"/>

            <!-- Avocado Seed Pit Belly / Face (Warm Amber Gold) -->
            <Border Width="18" Height="19" CornerRadius="9.5" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#B45309" Offset="0"/>
                        <GradientStop Color="#78350F" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Glistening Eyes (Animated Blink) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0">
                        <!-- Left Eye -->
                        <Grid x:Name="LeftEye" Margin="0,0,4,0" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleY="1.0"/>
                            </Grid.RenderTransform>
                            <Ellipse Width="4" Height="5" Fill="#1E1308"/>
                            <Ellipse Width="1.5" Height="1.5" Fill="#FFFFFF" Margin="0,0,1,2"/>
                        </Grid>
                        <!-- Right Eye -->
                        <Grid x:Name="RightEye" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleY="1.0"/>
                            </Grid.RenderTransform>
                            <Ellipse Width="4" Height="5" Fill="#1E1308"/>
                            <Ellipse Width="1.5" Height="1.5" Fill="#FFFFFF" Margin="0,0,1,2"/>
                        </Grid>
                    </StackPanel>
                    <!-- Pink Blush Cheeks -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0">
                        <Border Width="3" Height="2" CornerRadius="1" Background="#FB7185" Opacity="0.8" Margin="0,0,8,0"/>
                        <Border Width="3" Height="2" CornerRadius="1" Background="#FB7185" Opacity="0.8"/>
                    </StackPanel>
                    <!-- Happy Smile Curve -->
                    <Path Data="M 1,0 Q 2.5,2 4,0" Stroke="#FEF3C7" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" 
                          HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                </Grid>
            </Border>

            <!-- Sprout Leaf on Top of Head with gentle wave -->
            <Path x:Name="SproutLeaf" Data="M 19,6 C 17,1 23,0 24,2 C 24,5 21,6 19,6 Z" Fill="#34D399" RenderTransformOrigin="0.2,1.0">
                <Path.RenderTransform>
                    <RotateTransform Angle="0"/>
                </Path.RenderTransform>
            </Path>
        </Grid>
        <ControlTemplate.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever">
                        <!-- Idle Cute Breathing / Peek Squash-Stretch -->
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MascotScale" Storyboard.TargetProperty="ScaleY">
                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1.06"/>
                            <SplineDoubleKeyFrame KeyTime="0:0:2.8" Value="1.0"/>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MascotScale" Storyboard.TargetProperty="ScaleX">
                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="0.97"/>
                            <SplineDoubleKeyFrame KeyTime="0:0:2.8" Value="1.0"/>
                        </DoubleAnimationUsingKeyFrames>
                        <!-- Sprout leaf breeze waggle -->
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SproutLeaf" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)">
                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                            <SplineDoubleKeyFrame KeyTime="0:0:0.7" Value="8"/>
                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="-4"/>
                            <SplineDoubleKeyFrame KeyTime="0:0:2.1" Value="6"/>
                            <SplineDoubleKeyFrame KeyTime="0:0:2.8" Value="0"/>
                        </DoubleAnimationUsingKeyFrames>
                        <!-- Cute Eye Blink every 2.8s cycle -->
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LeftEye" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.4" Value="1.0"/>
                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.45" Value="0.1"/>
                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.55" Value="1.0"/>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RightEye" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.4" Value="1.0"/>
                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.45" Value="0.1"/>
                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.55" Value="1.0"/>
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Consistent Compact Avocado Mascot for Headers & Title Bars (20x22 ViewBox) -->
    <ControlTemplate x:Key="AvocadoMascotCompact">
        <Viewbox Width="20" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ContentControl Template="{StaticResource AvocadoMascot}"/>
        </Viewbox>
    </ControlTemplate>

    <!-- Empty Sessions Vector Illustration (Guac with notepad/archive folder) -->
    <ControlTemplate x:Key="EmptySessionsIllustration">
        <Grid Width="110" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Ambient Soft Glow Circle -->
            <Ellipse Width="88" Height="88" Fill="{DynamicResource BgCardBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse.Effect>
                    <BlurEffect Radius="18"/>
                </Ellipse.Effect>
            </Ellipse>

            <!-- Illustrated Dashed Session Outline Tray -->
            <Border Width="82" Height="64" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6" Background="{DynamicResource BgSecondaryBrush}" Opacity="0.75">
                <Grid>
                    <!-- Folder Tab Notch -->
                    <Border Width="28" Height="6" CornerRadius="3" Background="{DynamicResource BorderBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0" Opacity="0.5"/>
                    <Border Width="40" Height="4" CornerRadius="2" Background="{DynamicResource BorderBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,19,0,0" Opacity="0.3"/>
                    <Border Width="24" Height="4" CornerRadius="2" Background="{DynamicResource BorderBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,27,0,0" Opacity="0.2"/>
                </Grid>
            </Border>

            <!-- Guac QA Mascot Peeking Happily over the Folder -->
            <Viewbox Width="52" Height="60" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="14,2,0,0">
                <ContentControl Template="{StaticResource AvocadoMascot}"/>
            </Viewbox>

            <!-- Floating Mini Sparkle Star -->
            <Path Data="M 0,4 Q 4,4 4,0 Q 4,4 8,4 Q 4,4 4,8 Q 4,4 0,4 Z" Fill="{DynamicResource AccentBrush}" Opacity="0.65" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,14,0"/>
        </Grid>
    </ControlTemplate>

    <!-- Empty Bugs & Evidence Vector Illustration (Guac with Inspection Magnifier & Serene All-Clear) -->
    <ControlTemplate x:Key="EmptyBugsIllustration">
        <Grid Width="160" Height="120" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Soft Ambient Halo -->
            <Ellipse Width="110" Height="110" Fill="{DynamicResource BgCardBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse.Effect>
                    <BlurEffect Radius="24"/>
                </Ellipse.Effect>
            </Ellipse>

            <!-- Sleek Verification Shield Vector Backdrop -->
            <Path Data="M12,1 L3,5 L3,11 C3,16.55 6.84,21.74 12,23 C17.16,21.74 21,16.55 21,11 L21,5 L12,1 Z" 
                  Fill="{DynamicResource BgSecondaryBrush}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1.2"
                  Stretch="Uniform" Width="80" Height="80" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"/>

            <!-- Centered Guac QA Mascot in Verification Pose -->
            <Viewbox Width="64" Height="72" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0">
                <ContentControl Template="{StaticResource AvocadoMascot}"/>
            </Viewbox>

            <!-- Magnifying Glass Vector held on side -->
            <Canvas Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,12">
                <!-- Lens Ring -->
                <Ellipse Width="18" Height="18" Canvas.Left="2" Canvas.Top="2" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.5" Fill="{DynamicResource BgCardBrush}" Opacity="0.95"/>
                <!-- Lens Reflection -->
                <Path Data="M 6,5 A 6,6 0 0 1 14,7" Stroke="#FFFFFF" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.7"/>
                <!-- Handle -->
                <Line X1="15" Y1="15" X2="27" Y2="27" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <!-- Checkmark inside lens for 'Clean' -->
                <Path Data="M 7,11 L 10,14 L 14,8" Stroke="{DynamicResource SuccessBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Canvas>

            <!-- Floating Sparkle Stars -->
            <Path Data="M 0,5 Q 5,5 5,0 Q 5,5 10,5 Q 5,5 5,10 Q 5,5 0,5 Z" Fill="{DynamicResource GoldBrush}" Opacity="0.8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="22,18,0,0"/>
            <Path Data="M 0,3 Q 3,3 3,0 Q 3,3 6,3 Q 3,3 3,6 Q 3,3 0,3 Z" Fill="{DynamicResource AccentBrush}" Opacity="0.5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,22,28,0"/>
        </Grid>
    </ControlTemplate>

    <!-- Global Base Window & Font Styling -->
    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif"/>
        <Setter Property="Background" Value="{StaticResource BgPrimaryBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <!-- Global TextBlock -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif"/>
    </Style>

    <!-- Global TextBox Styling (Theme-aware, Nordic Slate Focus) -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource BgCardBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="FontFamily" Value="Segoe UI, -apple-system, BlinkMacSystemFont, sans-serif"/>
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="true">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource BgSecondaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Invisible ScrollBar Style (Allows Mouse Wheel & Touch Scrolling without Any Visual Bars) -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="0"/>
        <Setter Property="Height" Value="0"/>
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Width="0" Height="0" Visibility="Collapsed"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ToggleButton Template for ComboBox -->
    <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
        <Border x:Name="templateRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" SnapsToDevicePixels="true">
            <Grid HorizontalAlignment="Right" Width="26">
                <Path x:Name="arrow" Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="templateRoot" Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}"/>
                <Setter TargetName="arrow" Property="Fill" Value="{DynamicResource TextPrimaryBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="true">
                <Setter TargetName="templateRoot" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="arrow" Property="Fill" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Global ComboBox Styling with Dynamic Theme Popup -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource BgCardBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontFamily" Value="Segoe UI, sans-serif"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="true"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="templateRoot" SnapsToDevicePixels="true">
                        <ToggleButton x:Name="toggleButton" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" ClickMode="Press" Focusable="false" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Template="{StaticResource ComboBoxToggleButton}"/>
                        <ContentPresenter x:Name="contentPresenter" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Content="{TemplateBinding SelectionBoxItem}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" IsHitTestVisible="false" Margin="{TemplateBinding Padding}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        <Popup x:Name="PART_Popup" AllowsTransparency="true" Focusable="false" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Bottom" PopupAnimation="Slide">
                            <Border x:Name="dropDownBorder" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{Binding ActualWidth, ElementName=templateRoot}" Margin="0,4,0,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.5"/>
                                </Border.Effect>
                                <ScrollViewer x:Name="DropDownScrollViewer" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                    <Grid x:Name="grid" RenderOptions.ClearTypeHint="Enabled">
                                        <Canvas x:Name="canvas" HorizontalAlignment="Left" Height="0" VerticalAlignment="Top" Width="0">
                                            <Rectangle x:Name="opaqueRect" Fill="{Binding Background, ElementName=dropDownBorder}" Height="{Binding ActualHeight, ElementName=dropDownBorder}" Width="{Binding ActualWidth, ElementName=dropDownBorder}"/>
                                        </Canvas>
                                        <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </Grid>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="toggleButton" Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="true">
                            <Setter TargetName="toggleButton" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="2,1">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgSecondaryBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BorderBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Global CheckBox Styling (Theme-Adaptive Cinematic Design) -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Check Box Visual Box -->
                        <Border x:Name="CheckBorder" Grid.Column="0" Width="18" Height="18" CornerRadius="4" 
                                Background="{DynamicResource BgCardBrush}" 
                                BorderBrush="{DynamicResource BorderBrush}" 
                                BorderThickness="1.5" 
                                VerticalAlignment="Center" 
                                Margin="0,0,10,0">
                            <!-- Checkmark Glyph (Centered 10x8 viewBox) -->
                            <Viewbox Width="11" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path x:Name="CheckMark" 
                                      Data="M 1.5 5.5 L 4.5 8.5 L 10.5 1.5" 
                                      Stroke="{DynamicResource ButtonForegroundBrush}" 
                                      StrokeThickness="2" 
                                      StrokeStartLineCap="Round" 
                                      StrokeEndLineCap="Round" 
                                      StrokeLineJoin="Round" 
                                      Opacity="0"/>
                            </Viewbox>
                        </Border>

                        <!-- Content Presenter for Text / Children -->
                        <ContentPresenter Grid.Column="1" 
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                          RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Hover State -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}"/>
                            <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource BgSecondaryBrush}"/>
                        </Trigger>
                        <!-- Checked State -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="CheckMark" Property="Opacity" Value="1"/>
                        </Trigger>
                        <!-- Hover while Checked -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="CheckBorder" Property="Opacity" Value="0.9"/>
                        </MultiTrigger>
                        <!-- Disabled State -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="CheckBorder" Property="Opacity" Value="0.4"/>
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Global Slider Styling (Smooth Theme-Adaptive Cinematic Dragger / Thumb) -->
    <!-- Custom Slider Thumb Style -->
    <Style x:Key="SliderThumbStyle" TargetType="Thumb">
        <Setter Property="SnapsToDevicePixels" Value="true"/>
        <Setter Property="OverridesDefaultStyle" Value="true"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="18" Height="18">
                        <!-- Outer Glow Ring on Hover -->
                        <Ellipse x:Name="GlowRing" Width="18" Height="18" Fill="{DynamicResource AccentBrush}" Opacity="0"/>
                        <!-- Main Thumb Pill / Disc -->
                        <Ellipse x:Name="ThumbDisc" Width="14" Height="14" Fill="{DynamicResource TextPrimaryBrush}" Stroke="{DynamicResource BgCardBrush}" StrokeThickness="2.5">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.4"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="GlowRing" Property="Opacity" Value="0.3"/>
                            <Setter TargetName="ThumbDisc" Property="Width" Value="15"/>
                            <Setter TargetName="ThumbDisc" Property="Height" Value="15"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="true">
                            <Setter TargetName="GlowRing" Property="Opacity" Value="0.5"/>
                            <Setter TargetName="ThumbDisc" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Horizontal Slider Template -->
    <ControlTemplate x:Key="HorizontalSliderTemplate" TargetType="Slider">
        <Grid VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Background Track -->
            <Border x:Name="TrackBackground" Grid.Row="1" Height="6" CornerRadius="3" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center"/>
            <Track x:Name="PART_Track" Grid.Row="1">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                        <RepeatButton.Template>
                            <ControlTemplate TargetType="RepeatButton">
                                <Border Height="6" CornerRadius="3,0,0,3" Background="{DynamicResource AccentBrush}"/>
                            </ControlTemplate>
                        </RepeatButton.Template>
                    </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                        <RepeatButton.Template>
                            <ControlTemplate TargetType="RepeatButton">
                                <Border Height="6" Background="Transparent"/>
                            </ControlTemplate>
                        </RepeatButton.Template>
                    </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource SliderThumbStyle}" VerticalAlignment="Center"/>
                </Track.Thumb>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="TrackBackground" Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Template" Value="{StaticResource HorizontalSliderTemplate}"/>
    </Style>

    <!-- Button Style Primary (Nordic Minimalist Crisp Action) -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource PrimaryAccentGradient}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btnBorder" Property="Opacity" Value="0.92"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="btnBorder" Property="Opacity" Value="0.75"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Button Style Secondary (Titanium Hairline) -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource BgCardBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="secBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="secBorder" Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}"/>
                            <Setter TargetName="secBorder" Property="Background" Value="{DynamicResource BgSecondaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Window Chrome Control Button (Minimize, Maximize, Close) -->
    <Style x:Key="WindowControlButton" TargetType="Button">
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#1A10B981"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#3310B981"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Window Close Button -->
    <Style x:Key="WindowCloseButton" TargetType="Button">
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#E11D48"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#BE123C"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Danger Button -->
    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="Background" Value="#DC2626"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="13,7"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="dBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="dBorder" Property="Background" Value="#EF4444"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- IDE Header Icon Tool Button Style (Clean, borderless, subtle hover like VS Code / JetBrains / Chrome) -->
    <Style x:Key="HeaderIconButton" TargetType="Button">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="1,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgCardBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BorderBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Floating Quick Ball Circular Action Button Style -->
    <Style x:Key="QuickBallCircleButton" TargetType="Button">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Background" Value="{DynamicResource BgCardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="circBd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="17">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.5"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="circBd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="circBd" Property="Background" Value="{DynamicResource BgSecondaryBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="circBd" Property="Background" Value="{DynamicResource BorderBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
