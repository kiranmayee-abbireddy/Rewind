<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Nordic Minimalist Cinematic Studio Palette (Slate, Titanium, Pure Chalk & Quiet Accents) -->
    <Color x:Key="BgPrimaryColor">#121418</Color>
    <Color x:Key="BgSecondaryColor">#181B20</Color>
    <Color x:Key="BgCardColor">#1E2229</Color>
    <Color x:Key="BorderColor">#2A303C</Color>
    <Color x:Key="BorderFocusColor">#4E5A6E</Color>
    <Color x:Key="TextPrimaryColor">#F3F5F7</Color>
    <Color x:Key="TextSecondaryColor">#8E98A8</Color>
    <Color x:Key="AccentColor">#E2E8F0</Color>
    <Color x:Key="ButtonForegroundColor">#0F172A</Color>
    <Color x:Key="GoldColor">#E5A93C</Color>
    <Color x:Key="DangerColor">#E05252</Color>
    <Color x:Key="SuccessColor">#38A169</Color>
    <Color x:Key="WarningColor">#E5A93C</Color>

    <SolidColorBrush x:Key="BgPrimaryBrush" Color="{StaticResource BgPrimaryColor}" />
    <SolidColorBrush x:Key="BgSecondaryBrush" Color="{StaticResource BgSecondaryColor}" />
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderFocusBrush" Color="{StaticResource BorderFocusColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{StaticResource ButtonForegroundColor}" />
    <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource GoldColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />

    <!-- Nordic Cinematic Subtle Gradient Brushes -->
    <LinearGradientBrush x:Key="PrimaryAccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F1F5F9" Offset="0"/>
        <GradientStop Color="#CBD5E1" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LogoOrbGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#94A3B8" Offset="0"/>
        <GradientStop Color="#475569" Offset="0.5"/>
        <GradientStop Color="#1E293B" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GoldOrbGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FCD34D" Offset="0"/>
        <GradientStop Color="#F59E0B" Offset="0.6"/>
        <GradientStop Color="#B45309" Offset="1"/>
    </LinearGradientBrush>

    <!-- Theme-Adaptive Studio Canvas Gradient Brush -->
    <LinearGradientBrush x:Key="MainWorkspaceGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{DynamicResource BgPrimaryColor}" Offset="0.0"/>
        <GradientStop Color="{DynamicResource BgSecondaryColor}" Offset="0.55"/>
        <GradientStop Color="{DynamicResource BgCardColor}" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Theme-Adaptive Topographic Contour Line Brush -->
    <SolidColorBrush x:Key="TopoContourBrush" Color="{DynamicResource BorderColor}" Opacity="0.28"/>

    <!-- Devin-Style Topographic Contour Iso-Curves Pattern Brush (Faithful 800x600 Reference Layout) -->
    <DrawingBrush x:Key="TopographicContourPatternBrush" Stretch="UniformToFill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <!-- Transparent background so the rich gradient shows underneath -->
                <GeometryDrawing Brush="Transparent">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,800,600"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                
                <!-- 1. Authentic Devin Large Rounded Hexagonal Mechanical Gear/Aura (Anchored on Left Center) -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="{DynamicResource TopoContourBrush}" Thickness="1.4" LineJoin="Round" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <!-- Rounded hexagonal contour on left-center -->
                        <PathGeometry Figures="
                            M -120,80 L 80,180 A 60,60 0 0 1 110,230 L 110,370 A 60,60 0 0 1 80,420 L -120,520
                            M -170,30 L 120,150 A 90,90 0 0 1 160,220 L 160,380 A 90,90 0 0 1 120,450 L -170,570
                        "/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- 2. Smooth Top-Left Flowing S-Curves & Contours -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="{DynamicResource TopoContourBrush}" Thickness="1.4" LineJoin="Round" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="
                            M -80,50 C 40,50 80,-40 220,-40 C 360,-40 420,50 560,50 C 700,50 740,-30 840,-30
                            M -80,-10 C 60,-10 100,-90 240,-90 C 380,-90 440,-10 580,-10 C 720,-10 760,-80 860,-80
                        "/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- 3. Dynamic Organic Flowing Ribbons Traversing Upper-Right to Lower-Left -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="{DynamicResource TopoContourBrush}" Thickness="1.4" LineJoin="Round" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="
                            M -40,300 C 60,300 130,220 180,140 C 230,60 310,0 440,0 C 580,0 660,90 710,180 C 760,270 820,330 900,330
                            M -40,430 C 80,430 160,340 220,240 C 280,140 370,80 500,80 C 630,80 710,170 760,260 C 800,340 850,400 900,410
                            M -40,560 C 100,560 190,460 260,340 C 330,220 430,160 560,160 C 690,160 760,250 810,340 C 840,400 870,460 900,480
                        "/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- 4. Devin Circular Orbit Contour on the Mid-Right (Where the avocado companion floats) -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="{DynamicResource TopoContourBrush}" Thickness="1.4" LineJoin="Round" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="
                            M 840,110 A 240,240 0 0 0 600,350 A 240,240 0 0 0 840,590
                            M 840,180 A 170,170 0 0 0 670,350 A 170,170 0 0 0 840,520
                        "/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Ultra-Clean Modern Studio Pattern Brushes (Softer, subtle, premium aesthetic) -->
    <VisualBrush x:Key="DevinGridPatternBrush" TileMode="Tile" Viewport="0,0,28,28" ViewportUnits="Absolute">
        <VisualBrush.Visual>
            <Canvas Width="28" Height="28" Background="Transparent">
                <Line X1="0" Y1="0" X2="28" Y2="0" Stroke="{DynamicResource BorderBrush}" StrokeThickness="0.5" Opacity="0.18"/>
                <Line X1="0" Y1="0" X2="0" Y2="28" Stroke="{DynamicResource BorderBrush}" StrokeThickness="0.5" Opacity="0.18"/>
                <!-- Subtle soft intersection dot -->
                <Ellipse Width="1" Height="1" Canvas.Left="-0.5" Canvas.Top="-0.5" Fill="{DynamicResource BorderBrush}" Opacity="0.25"/>
            </Canvas>
        </VisualBrush.Visual>
    </VisualBrush>

    <!-- Main Workspace Studio Grid (Calm, expansive 36x36 with radial aura capability) -->
    <VisualBrush x:Key="DevinStudioPatternBrush" TileMode="Tile" Viewport="0,0,36,36" ViewportUnits="Absolute">
        <VisualBrush.Visual>
            <Canvas Width="36" Height="36" Background="Transparent">
                <Line X1="0" Y1="0" X2="36" Y2="0" Stroke="{DynamicResource BorderBrush}" StrokeThickness="0.5" Opacity="0.12"/>
                <Line X1="0" Y1="0" X2="0" Y2="36" Stroke="{DynamicResource BorderBrush}" StrokeThickness="0.5" Opacity="0.12"/>
                <!-- Minimal clean corner tick -->
                <Ellipse Width="1" Height="1" Canvas.Left="-0.5" Canvas.Top="-0.5" Fill="{DynamicResource BorderBrush}" Opacity="0.18"/>
            </Canvas>
        </VisualBrush.Visual>
    </VisualBrush>

