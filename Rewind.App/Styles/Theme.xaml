    <!-- Adorable Chubby Avocado QA Mascot (Exactly matching reference artwork - 100x120 vector canvas) -->
    <ControlTemplate x:Key="AvocadoMascot">
        <Viewbox Width="54" Height="65" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="100" Height="120">
                <!-- Drop shadow beneath feet -->
                <Ellipse Canvas.Left="20" Canvas.Top="108" Width="60" Height="10" Fill="#15000000"/>

                <!-- Stubby Feet (Dark forest avocado green with dark outline, like in reference) -->
                <!-- Left Foot -->
                <Path Data="M 33,102 C 33,113 45,113 45,102 Z" Fill="#2D5A27" Stroke="#163814" StrokeThickness="2.5" StrokeLineJoin="Round"/>
                <!-- Right Foot -->
                <Path Data="M 55,102 C 55,113 67,113 67,102 Z" Fill="#2D5A27" Stroke="#163814" StrokeThickness="2.5" StrokeLineJoin="Round"/>

                <!-- Cute Outstretched Stubby Arms -->
                <!-- Left Arm: angled slightly downward-outward -->
                <Path Data="M 27,55 C 16,56 16,68 25,69 C 27,69 29,67 30,64 Z" Fill="#70B843" Stroke="#163814" StrokeThickness="2.5" StrokeLineJoin="Round"/>
                <!-- Right Arm: angled slightly downward-outward -->
                <Path Data="M 73,55 C 84,56 84,68 75,69 C 73,69 71,67 70,64 Z" Fill="#70B843" Stroke="#163814" StrokeThickness="2.5" StrokeLineJoin="Round"/>

                <!-- Cute Top Stem & Sprout Leaf (Right at top center X=50) -->
                <!-- Brown Stem -->
                <Path Data="M 48,22 C 48,13 52,9 52,5 C 55,5 55,8 53,13 C 51,18 51,22 51,22 Z" Fill="#633917" Stroke="#381E09" StrokeThickness="2" StrokeLineJoin="Round"/>
                <!-- Cute Leaf curving to the right -->
                <Path x:Name="SproutLeaf" Data="M 52,14 C 68,9 74,18 64,24 C 57,28 52,20 52,14 Z" Fill="#4CAF50" Stroke="#163814" StrokeThickness="2" RenderTransformOrigin="0.0,0.7">
                    <Path.RenderTransform>
                        <RotateTransform Angle="0"/>
                    </Path.RenderTransform>
                </Path>

                <!-- Outer Avocado Rind (Dark Avocado Green pear shape, thick outline) -->
                <Path Data="M 50,18 C 68,18 78,32 78,54 C 84,72 88,96 76,104 C 64,112 36,112 24,104 C 12,96 16,72 22,54 C 22,32 32,18 50,18 Z"
                      Fill="#235020" Stroke="#143212" StrokeThickness="3.5" StrokeLineJoin="Round"/>

                <!-- Inner Lime Margin (Bright fresh green rind border) -->
                <Path Data="M 50,21 C 66,21 75,34 75,54 C 81,71 85,93 74,101 C 63,109 37,109 26,101 C 15,93 19,71 25,54 C 25,34 34,21 50,21 Z"
                      Fill="#80C838"/>

                <!-- Creamy Light Honeydew / Pastel Yellow Flesh -->
                <Path Data="M 50,24 C 64,24 71,36 71,55 C 77,71 80,91 71,98 C 61,105 39,105 29,98 C 20,91 23,71 29,55 C 29,36 36,24 50,24 Z"
                      Fill="#E6F587"/>

                <!-- Perfectly Centered Round Brown Seed Pit (Belly) -->
                <!-- Outer Pit Circle with dark brown border -->
                <Ellipse Canvas.Left="34" Canvas.Top="62" Width="32" Height="32" Fill="#B35B1C" Stroke="#66310C" StrokeThickness="2.5"/>
                <!-- Pit depth shadow -->
                <Ellipse Canvas.Left="35" Canvas.Top="63" Width="30" Height="30">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.4,0.35" GradientOrigin="0.4,0.35" RadiusX="0.65" RadiusY="0.65">
                            <GradientStop Color="#DE7B2C" Offset="0"/>
                            <GradientStop Color="#B35B1C" Offset="0.5"/>
                            <GradientStop Color="#783408" Offset="0.9"/>
                            <GradientStop Color="#4A1E03" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <!-- Pit Crescent Shine Arc -->
                <Path Data="M 39,72 A 10,10 0 0 1 51,66" Stroke="#FFFFFF" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.65"/>
                <Ellipse Canvas.Left="40" Canvas.Top="68" Width="3.5" Height="2.5" Fill="#FFFFFF" Opacity="0.8"/>

                <!-- Kawaii Face - Sitting in Upper Flesh Directly Above Pit (X=50 center) -->
                <!-- Soft Pink Blush Cheeks (Centered symmetrically on both sides) -->
                <Ellipse Canvas.Left="31" Canvas.Top="47" Width="9" Height="5.5" Fill="#FFA1A1" Opacity="0.8"/>
                <Ellipse Canvas.Left="60" Canvas.Top="47" Width="9" Height="5.5" Fill="#FFA1A1" Opacity="0.8"/>

                <!-- Left Eye: Big cute anime eye looking directly straight forward -->
                <Canvas x:Name="LeftEye" Canvas.Left="38" Canvas.Top="38" Width="9" Height="10" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform>
                        <ScaleTransform ScaleY="1.0"/>
                    </Canvas.RenderTransform>
                    <!-- Dark pupil -->
                    <Ellipse Canvas.Left="0" Canvas.Top="0" Width="9" Height="10" Fill="#141414"/>
                    <!-- Big white sparkle catchlight (Upper inner highlight) -->
                    <Ellipse Canvas.Left="2" Canvas.Top="1.5" Width="4.2" Height="4.2" Fill="#FFFFFF"/>
                    <!-- Small secondary catchlight (Lower right) -->
                    <Ellipse Canvas.Left="5.5" Canvas.Top="6.5" Width="1.8" Height="1.8" Fill="#FFFFFF"/>
                </Canvas>

                <!-- Right Eye: Big cute anime eye looking directly straight forward (Symmetrically placed) -->
                <Canvas x:Name="RightEye" Canvas.Left="53" Canvas.Top="38" Width="9" Height="10" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform>
                        <ScaleTransform ScaleY="1.0"/>
                    </Canvas.RenderTransform>
                    <!-- Dark pupil -->
                    <Ellipse Canvas.Left="0" Canvas.Top="0" Width="9" Height="10" Fill="#141414"/>
                    <!-- Big white sparkle catchlight (Upper inner highlight) -->
                    <Ellipse Canvas.Left="2.8" Canvas.Top="1.5" Width="4.2" Height="4.2" Fill="#FFFFFF"/>
                    <!-- Small secondary catchlight (Lower left) -->
                    <Ellipse Canvas.Left="1.7" Canvas.Top="6.5" Width="1.8" Height="1.8" Fill="#FFFFFF"/>
                </Canvas>

                <!-- Cute Centered Sweet Smile (Right between eyes, curved up cheerfully) -->
                <Path Data="M 47,46 Q 50,50 53,46" Stroke="#141414" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Canvas>
        </Viewbox>
        <ControlTemplate.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever">
                        <!-- Sprout leaf breeze wave -->
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SproutLeaf" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)">
                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                            <SplineDoubleKeyFrame KeyTime="0:0:0.65" Value="8"/>
                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="-4"/>
                            <SplineDoubleKeyFrame KeyTime="0:0:1.95" Value="6"/>
                            <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="0"/>
                        </DoubleAnimationUsingKeyFrames>
                        <!-- Cute Eye Blink every 2.6s cycle -->
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LeftEye" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.2" Value="1.0"/>
                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.26" Value="0.08"/>
                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.36" Value="1.0"/>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RightEye" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.2" Value="1.0"/>
                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.26" Value="0.08"/>
                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.36" Value="1.0"/>
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Side-Glancing Peeking Avocado QA Mascot (Clean peeking head and face tilted from edge, NO limbs or legs) -->
    <ControlTemplate x:Key="AvocadoMascotPeeking">
        <Viewbox Width="54" Height="65" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="100" Height="120">
                <!-- Top Stem & Leaf tilted forward curiously -->
                <Path Data="M 45,22 C 45,13 49,9 49,5 C 52,5 52,8 50,13 C 48,18 48,22 48,22 Z" Fill="#633917" Stroke="#381E09" StrokeThickness="2" StrokeLineJoin="Round"/>
                <Path x:Name="PeekSproutLeaf" Data="M 49,14 C 65,9 71,18 61,24 C 54,28 49,20 49,14 Z" Fill="#4CAF50" Stroke="#163814" StrokeThickness="2" RenderTransformOrigin="0.0,0.7">
                    <Path.RenderTransform>
                        <RotateTransform Angle="0"/>
                    </Path.RenderTransform>
                </Path>

                <!-- Outer Avocado Rind (Side-turned 3/4 pear silhouette) -->
                <Path Data="M 47,18 C 65,18 75,32 75,54 C 81,72 85,96 73,104 C 61,112 33,112 21,104 C 9,96 13,72 19,54 C 19,32 29,18 47,18 Z"
                      Fill="#235020" Stroke="#143212" StrokeThickness="3.5" StrokeLineJoin="Round"/>

                <!-- Inner Lime Margin -->
                <Path Data="M 47,21 C 63,21 72,34 72,54 C 78,71 82,93 71,101 C 60,109 34,109 23,101 C 12,93 16,71 22,54 C 22,34 31,21 47,21 Z"
                      Fill="#80C838"/>

                <!-- Creamy Flesh -->
                <Path Data="M 47,24 C 61,24 68,36 68,55 C 74,71 77,91 68,98 C 58,105 36,105 26,98 C 17,91 20,71 26,55 C 26,36 33,24 47,24 Z"
                      Fill="#E6F587"/>

                <!-- Round Brown Seed Pit (Turned 3/4, slightly toward the peeking side) -->
                <Ellipse Canvas.Left="30" Canvas.Top="62" Width="32" Height="32" Fill="#B35B1C" Stroke="#66310C" StrokeThickness="2.5"/>
                <Ellipse Canvas.Left="31" Canvas.Top="63" Width="30" Height="30">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.35,0.35" GradientOrigin="0.35,0.35" RadiusX="0.65" RadiusY="0.65">
                            <GradientStop Color="#DE7B2C" Offset="0"/>
                            <GradientStop Color="#B35B1C" Offset="0.5"/>
                            <GradientStop Color="#783408" Offset="0.9"/>
                            <GradientStop Color="#4A1E03" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <!-- Pit Crescent Shine Arc -->
                <Path Data="M 34,71 A 10,10 0 0 1 46,65" Stroke="#FFFFFF" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.65"/>
                <Ellipse Canvas.Left="35" Canvas.Top="67" Width="3.5" Height="2.5" Fill="#FFFFFF" Opacity="0.8"/>

                <!-- Kawaii Side-Glancing Face (Both eyes and cheeks shifted side-peeking into the screen) -->
                <!-- Rosy Blush Cheeks -->
                <Ellipse Canvas.Left="26" Canvas.Top="48" Width="9" Height="5.5" Fill="#FFA1A1" Opacity="0.85"/>
                <Ellipse Canvas.Left="54" Canvas.Top="48" Width="8" Height="5" Fill="#FFA1A1" Opacity="0.65"/>

                <!-- Left Eye: Prominent side-eye peeking into the screen with big sparkle -->
                <Canvas x:Name="PeekLeftEye" Canvas.Left="33" Canvas.Top="38" Width="10" Height="11" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform>
                        <ScaleTransform ScaleY="1.0"/>
                    </Canvas.RenderTransform>
                    <!-- Dark pupil looking towards left (into the screen) -->
                    <Ellipse Canvas.Left="0" Canvas.Top="0" Width="10" Height="11" Fill="#141414"/>
                    <!-- Sparkle catchlights shifted leftward toward screen -->
                    <Ellipse Canvas.Left="1.5" Canvas.Top="1.8" Width="4.6" Height="4.6" Fill="#FFFFFF"/>
                    <Ellipse Canvas.Left="6.5" Canvas.Top="7" Width="1.8" Height="1.8" Fill="#FFFFFF"/>
                </Canvas>

                <!-- Right Eye: Foreshortened 3/4 perspective glance -->
                <Canvas x:Name="PeekRightEye" Canvas.Left="48" Canvas.Top="39" Width="8.5" Height="9.5" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform>
                        <ScaleTransform ScaleY="1.0"/>
                    </Canvas.RenderTransform>
