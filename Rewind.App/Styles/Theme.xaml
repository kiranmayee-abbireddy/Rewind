    <Geometry x:Key="GearGeometry">M12,15.5 A3.5,3.5 0 0 1 8.5,12 A3.5,3.5 0 0 1 12,8.5 A3.5,3.5 0 0 1 15.5,12 A3.5,3.5 0 0 1 12,15.5 M19.43,12.97 C19.47,12.65 19.5,12.33 19.5,12 C19.5,11.67 19.47,11.34 19.43,11 L21.54,9.37 C21.73,9.22 21.78,8.95 21.66,8.73 L19.66,5.27 C19.54,5.05 19.27,4.97 19.05,5.05 L16.56,6.05 C16.04,5.65 15.48,5.32 14.87,5.07 L14.49,2.42 C14.46,2.18 14.25,2 14,2 L10,2 C9.75,2 9.54,2.18 9.51,2.42 L9.13,5.07 C8.52,5.32 7.96,5.66 7.44,6.05 L4.95,5.05 C4.73,4.96 4.46,5.05 4.34,5.27 L2.34,8.73 C2.21,8.95 2.27,9.22 2.46,9.37 L4.57,11 C4.53,11.34 4.5,11.67 4.5,12 C4.5,12.33 4.53,12.65 4.57,12.97 L2.46,14.63 C2.27,14.78 2.21,15.05 2.34,15.27 L4.34,18.73 C4.46,18.95 4.73,19.03 4.95,18.95 L7.44,17.95 C7.96,18.34 8.52,18.68 9.13,18.93 L9.51,21.58 C9.54,21.82 9.75,22 10,22 L14,22 C14.25,22 14.46,21.82 14.49,21.58 L14.87,18.93 C15.48,18.68 16.04,18.34 16.56,17.95 L19.05,18.95 C19.27,19.04 19.54,18.95 19.66,18.73 L21.66,15.27 C21.78,15.05 21.73,14.78 21.54,14.63 L19.43,12.97 Z</Geometry>
    <Geometry x:Key="PlusGeometry">M19,13 H13 V19 H11 V13 H5 V11 H11 V5 H13 V11 H19 V13 Z</Geometry>
    <!-- Sleek Modern Theme Toggle Geometries (Standard Lucide/Feather Style) -->
    <Geometry x:Key="SunGeometry">M12,18 C8.69,18 6,15.31 6,12 C6,8.69 8.69,6 12,6 C15.31,6 18,8.69 18,12 C18,15.31 15.31,18 12,18 Z M11,1 L13,1 L13,4 L11,4 Z M11,20 L13,20 L13,23 L11,23 Z M1,11 L4,11 L4,13 L1,13 Z M20,11 L23,11 L23,13 L20,13 Z M4.22,4.22 L5.64,2.81 L7.76,4.93 L6.34,6.34 Z M16.24,16.24 L17.66,14.83 L19.78,16.95 L18.36,18.36 Z M4.22,19.78 L6.34,17.66 L7.76,19.07 L5.64,21.19 Z M16.24,7.76 L18.36,5.64 L19.78,7.05 L17.66,9.17 Z</Geometry>
    <Geometry x:Key="MoonGeometry">M21,12.79 C20.84,17.9 16.54,22 11.2,22 C5.57,22 1,17.43 1,11.8 C1,6.46 5.1,2.16 10.21,2 C10.63,2 10.87,2.49 10.6,2.81 C8.97,4.74 8.08,7.26 8.08,10 C8.08,16.08 12.92,20.92 19,20.92 C21.74,20.92 24.26,20.03 26.19,18.4 C26.51,18.13 27,18.37 27,18.79 C25.84,20.7 23.6,22 21,22 Z</Geometry>

    <!-- Crisp Professional Title Bar Window Control Geometries -->
    <Geometry x:Key="WinMinimizeGeometry">M0,5 L10,5 L10,6.2 L0,6.2 Z</Geometry>
    <Geometry x:Key="WinMaximizeGeometry">M1,1 L9,1 L9,9 L1,9 Z M0,0 L10,0 L10,10 L0,10 Z</Geometry>
    <Geometry x:Key="WinRestoreGeometry">M2,0 L10,0 L10,8 L8,8 L8,10 L0,10 L0,2 L2,2 Z M3,1 L3,2 L8,2 L8,7 L9,7 L9,1 Z M1,3 L1,9 L7,9 L7,3 Z</Geometry>
    <Geometry x:Key="WinCloseGeometry">M0.7,0 L5,4.3 L9.3,0 L10,0.7 L5.7,5 L10,9.3 L9.3,10 L5,5.7 L0.7,10 L0,9.3 L4.3,5 L0,0.7 Z</Geometry>
    <Geometry x:Key="WinHudPipetteGeometry">M12,2 C6.5,2 2,6.5 2,12 C2,17.5 6.5,22 12,22 C17.5,22 22,17.5 22,12 C22,6.5 17.5,2 12,2 Z M12,5 C14.5,5 17.5,8 17.5,12 C17.5,16 15,19 12,19 C9,19 6.5,16 6.5,12 C6.5,8 9.5,5 12,5 Z M12,9 A3,3 0 1,0 12,15 A3,3 0 1,0 12,9 Z</Geometry>
    <Geometry x:Key="WinExpandGeometry">M5,3 L9,3 L9,7 M9,3 L4,8 M11,13 L7,13 L7,9 M7,13 L12,8</Geometry>

    <!-- Adorable Borderless Avocado QA Mascot ("Guac" with QA headset) -->
    <ControlTemplate x:Key="AvocadoMascot">
        <Grid Width="38" Height="42" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Organic Pear-shaped Body (Rich Emerald with Subtle Drop Glow) -->
            <Path Data="M 19,3 C 27,3 32,10 32,21 C 32,32 27,40 19,40 C 11,40 6,32 6,21 C 6,10 11,3 19,3 Z">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#0D5F47" Offset="0"/>
                        <GradientStop Color="#064E3B" Offset="1"/>
                    </LinearGradientBrush>
                </Path.Fill>
                <Path.Effect>
                    <DropShadowEffect Color="#043226" BlurRadius="6" ShadowDepth="1" Opacity="0.5"/>
                </Path.Effect>
            </Path>

            <!-- Avocado Inner Flesh (Soft Creamy Honeydew/Lime Jade) -->
            <Path Data="M 19,6 C 25,6 29.5,12 29.5,21 C 29.5,30 25.5,37 19,37 C 12.5,37 8.5,30 8.5,21 C 8.5,12 13,6 19,6 Z">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#D1FAE5" Offset="0"/>
                        <GradientStop Color="#A7F3D0" Offset="0.5"/>
                        <GradientStop Color="#6EE7B7" Offset="1"/>
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>

            <!-- Cute QA Headset Arc -->
            <Path Data="M 7,20 C 7,8 31,8 31,20" Stroke="#10B981" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.85"/>
            <!-- Left Earpiece -->
            <Border Width="4" Height="7" CornerRadius="2" Background="#064E3B" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,1"/>
            <!-- Right Earpiece -->
            <Border Width="4" Height="7" CornerRadius="2" Background="#064E3B" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,1"/>

            <!-- Avocado Seed Pit Belly / Face (Warm Amber Gold) -->
            <Border Width="18" Height="19" CornerRadius="9.5" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#B45309" Offset="0"/>
                        <GradientStop Color="#78350F" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Glistening Eyes -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0">
                        <!-- Left Eye -->
                        <Grid Margin="0,0,4,0">
                            <Ellipse Width="4" Height="5" Fill="#1E1308"/>
                            <Ellipse Width="1.5" Height="1.5" Fill="#FFFFFF" Margin="0,0,1,2"/>
                        </Grid>
                        <!-- Right Eye -->
                        <Grid>
                            <Ellipse Width="4" Height="5" Fill="#1E1308"/>
                            <Ellipse Width="1.5" Height="1.5" Fill="#FFFFFF" Margin="0,0,1,2"/>
                        </Grid>
                    </StackPanel>
                    <!-- Pink Blush Cheeks -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0">
                        <Border Width="3" Height="2" CornerRadius="1" Background="#FB7185" Opacity="0.8" Margin="0,0,8,0"/>
                        <Border Width="3" Height="2" CornerRadius="1" Background="#FB7185" Opacity="0.8"/>
                    </StackPanel>
                    <!-- Happy Smile Curve -->
                    <Path Data="M 1,0 Q 2.5,2 4,0" Stroke="#FEF3C7" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" 
                          HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                </Grid>
            </Border>

            <!-- Sprout Leaf on Top of Head -->
            <Path Data="M 19,3 C 17,-2 23,-3 24,-1 C 24,2 21,3 19,3 Z" Fill="#34D399"/>
        </Grid>
    </ControlTemplate>

    <!-- Consistent Compact Avocado Mascot for Headers & Title Bars (24x26 ViewBox) -->
    <ControlTemplate x:Key="AvocadoMascotCompact">
        <Viewbox Width="22" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ContentControl Template="{StaticResource AvocadoMascot}"/>
        </Viewbox>
    </ControlTemplate>

    <!-- Global Base Window & Font Styling -->
    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif"/>
        <Setter Property="Background" Value="{StaticResource BgPrimaryBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <!-- Global TextBlock -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif"/>
    </Style>

    <!-- Global TextBox Styling -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="#111620"/>
        <Setter Property="Foreground" Value="#F3F6FC"/>
        <Setter Property="BorderBrush" Value="#253043"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="FontFamily" Value="Segoe UI, sans-serif"/>
        <Setter Property="CaretBrush" Value="#388BFD"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="border" Property="BorderBrush" Value="#388BFD"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="true">
                            <Setter TargetName="border" Property="BorderBrush" Value="#60A5FA"/>
                            <Setter TargetName="border" Property="Background" Value="#141B26"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Button Style Primary (Nordic Minimalist Crisp Action) -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource PrimaryAccentGradient}"/>
        <Setter Property="Foreground" Value="#0F172A"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusColor}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btnBorder" Property="Opacity" Value="0.92"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="btnBorder" Property="Opacity" Value="0.75"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Button Style Secondary (Titanium Hairline) -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource BgCardBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="secBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="secBorder" Property="BorderBrush" Value="{DynamicResource BorderFocusColor}"/>
                            <Setter TargetName="secBorder" Property="Background" Value="{DynamicResource BgSecondaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Window Chrome Control Button (Minimize, Maximize, Close) -->
    <Style x:Key="WindowControlButton" TargetType="Button">
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#1A10B981"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#3310B981"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Window Close Button -->
    <Style x:Key="WindowCloseButton" TargetType="Button">
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#E11D48"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#BE123C"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ToggleButton Template for ComboBox -->
    <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
        <Border x:Name="templateRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" SnapsToDevicePixels="true">
            <Grid HorizontalAlignment="Right" Width="26">
                <Path x:Name="arrow" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="templateRoot" Property="BorderBrush" Value="#388BFD"/>
                <Setter TargetName="arrow" Property="Fill" Value="#388BFD"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="true">
                <Setter TargetName="templateRoot" Property="BorderBrush" Value="#388BFD"/>
                <Setter TargetName="arrow" Property="Fill" Value="#388BFD"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Global ComboBox Styling with Dark Glass Popup -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="#111620"/>
        <Setter Property="Foreground" Value="#F3F6FC"/>
        <Setter Property="BorderBrush" Value="#253043"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontFamily" Value="Segoe UI, sans-serif"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="true"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="templateRoot" SnapsToDevicePixels="true">
                        <ToggleButton x:Name="toggleButton" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" ClickMode="Press" Focusable="false" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Template="{StaticResource ComboBoxToggleButton}"/>
                        <ContentPresenter x:Name="contentPresenter" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Content="{TemplateBinding SelectionBoxItem}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" IsHitTestVisible="false" Margin="{TemplateBinding Padding}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        <Popup x:Name="PART_Popup" AllowsTransparency="true" Focusable="false" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Bottom" PopupAnimation="Slide">
                            <Border x:Name="dropDownBorder" Background="#111620" BorderBrush="#253043" BorderThickness="1" CornerRadius="8" MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{Binding ActualWidth, ElementName=templateRoot}" Margin="0,4,0,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.85"/>
                                </Border.Effect>
                                <ScrollViewer x:Name="DropDownScrollViewer">
                                    <Grid x:Name="grid" RenderOptions.ClearTypeHint="Enabled">
                                        <Canvas x:Name="canvas" HorizontalAlignment="Left" Height="0" VerticalAlignment="Top" Width="0">
                                            <Rectangle x:Name="opaqueRect" Fill="{Binding Background, ElementName=dropDownBorder}" Height="{Binding ActualHeight, ElementName=dropDownBorder}" Width="{Binding ActualWidth, ElementName=dropDownBorder}"/>
                                        </Canvas>
                                        <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </Grid>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="toggleButton" Property="BorderBrush" Value="#388BFD"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="true">
                            <Setter TargetName="toggleButton" Property="BorderBrush" Value="#388BFD"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#F3F6FC"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="2,1">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#1E293B"/>
                            <Setter Property="Foreground" Value="#388BFD"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#1D4ED8"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Global CheckBox Styling -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="#F3F6FC"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- Global Slider Styling -->
    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="#388BFD"/>
        <Setter Property="Background" Value="#253043"/>
    </Style>

    <!-- Danger Button -->
    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="Background" Value="#DC2626"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="13,7"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="dBorder" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="dBorder" Property="Background" Value="#EF4444"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
