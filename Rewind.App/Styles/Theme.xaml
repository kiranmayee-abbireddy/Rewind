                <Ellipse Canvas.Left="25" Canvas.Top="15" Width="170" Height="130" Fill="{DynamicResource BgCardBrush}" Opacity="0.85">
                    <Ellipse.Effect>
                        <BlurEffect Radius="20"/>
                    </Ellipse.Effect>
                </Ellipse>

                <!-- Ground Shadow -->
                <Ellipse Canvas.Left="35" Canvas.Top="145" Width="150" Height="14" Fill="#14000000"/>

                <!-- Left Decorative Prop: Sleek Clean Recycling Bin Container with Emblem -->
