                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0"/>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BugsLeftEye" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.4" Value="1.0"/>
                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.46" Value="0.08"/>
                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.56" Value="1.0"/>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BugsRightEye" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.4" Value="1.0"/>
                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.46" Value="0.08"/>
                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.56" Value="1.0"/>
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- 3. EMPTY RECYCLE BIN ILLUSTRATION: Relieved Peaceful Avocado holding Clean Placard & Sleek Tapered Bin (NO TEXT) -->
    <ControlTemplate x:Key="EmptyRecycleBinIllustration">
        <Viewbox Width="200" Height="150" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="220" Height="170">
